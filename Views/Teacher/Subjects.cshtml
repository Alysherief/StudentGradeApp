@model IEnumerable<StudentGradeApp.Models.Subject>

@{
    ViewData["Title"] = "My Subjects";
}

<div class="container teacher-subjects-page">

    <div class="subjects-hero">

        <div class="hero-icon">
            <i class="bi bi-journal-bookmark-fill"></i>
        </div>

        <div>
            <h1>My Subjects</h1>
            <p>
                View and manage the subjects assigned to you.
            </p>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="empty-card">

            <div class="empty-icon">
                <i class="bi bi-journal-x"></i>
            </div>

            <h3>No Subjects Assigned</h3>

            <p>
                You have not been assigned any subjects yet.
            </p>

        </div>
    }
    else
    {
        <div class="subjects-header">

            <div>
                <h2>Your Teaching Subjects</h2>
                <p>
                    Subjects currently assigned to you.
                </p>
            </div>

            <div class="subject-count">
                <i class="bi bi-book-fill"></i>
                @Model.Count() Subjects
            </div>

        </div>

        <div class="row g-4">

            @foreach (var subject in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <div class="subject-card h-100">

                        <div class="subject-card-top">

                            <div class="subject-icon">
                                <i class="bi bi-book-half"></i>
                            </div>

                            <span class="assigned-badge">
                                <i class="bi bi-check-circle-fill"></i>
                                Assigned
                            </span>

                        </div>

                        <div class="subject-content">

                            <span class="subject-code">
                                @subject.Code
                            </span>

                            <h3>
                                @subject.Name
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(subject.Description))
                            {
                                <p class="subject-description">
                                    @subject.Description
                                </p>
                            }
                            else
                            {
                                <p class="subject-description">
                                    No description available for this subject.
                                </p>
                            }

                        </div>

                        <div class="subject-footer">

                            <div class="credit-hours">

                                <div class="footer-icon">
                                    <i class="bi bi-clock-fill"></i>
                                </div>

                                <div>
                                    <span>Credit Hours</span>
                                    <strong>
                                        @subject.CreditHours
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="bottom-actions">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-light action-btn">

            <i class="bi bi-arrow-left me-2"></i>
            Dashboard

        </a>

        <a asp-controller="Teacher"
           asp-action="Grades"
           class="btn btn-primary action-btn">

            <i class="bi bi-bar-chart-fill me-2"></i>
            Manage Grades

        </a>

    </div>

</div>

<style>

    .teacher-subjects-page {
        padding: 35px 0 60px;
    }

    .subjects-hero {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 35px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0d6efd, #5b8def);
        color: white;
        box-shadow: 0 15px 35px rgba(13, 110, 253, .18);
        margin-bottom: 30px;
    }

    .hero-icon {
        width: 65px;
        height: 65px;
        border-radius: 19px;
        background: rgba(255, 255, 255, .18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        flex-shrink: 0;
    }

    .subjects-hero h1 {
        margin: 0 0 6px;
        font-size: 2rem;
        font-weight: 800;
    }

    .subjects-hero p {
        margin: 0;
        opacity: .9;
    }

    .subjects-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

        .subjects-header h2 {
            margin: 0 0 5px;
            font-size: 1.35rem;
            font-weight: 800;
            color: #17233c;
        }

        .subjects-header p {
            margin: 0;
            color: #6c757d;
            font-size: 14px;
        }

    .subject-count {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #eaf2ff;
        color: #0d6efd;
        padding: 10px 15px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .subject-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .055);
        transition: all .25s ease;
        display: flex;
        flex-direction: column;
    }

        .subject-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 38px rgba(0, 0, 0, .10);
            border-color: #dce8ff;
        }

    .subject-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 22px 0;
    }

    .subject-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .assigned-badge {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 7px 10px;
        border-radius: 10px;
        background: #e9f8ef;
        color: #198754;
        font-size: 11px;
        font-weight: 700;
    }

    .subject-content {
        padding: 20px 22px;
        flex: 1;
    }

    .subject-code {
        display: inline-block;
        color: #0d6efd;
        background: #edf4ff;
        padding: 5px 9px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .3px;
        margin-bottom: 10px;
    }

    .subject-content h3 {
        margin: 0 0 10px;
        font-size: 1.2rem;
        font-weight: 800;
        color: #17233c;
        line-height: 1.35;
    }

    .subject-description {
        margin: 0;
        color: #6c757d;
        font-size: 13px;
        line-height: 1.6;
    }

    .subject-footer {
        border-top: 1px solid #edf0f4;
        padding: 17px 22px;
        background: #fbfcfe;
    }

    .credit-hours {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .footer-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }

    .credit-hours span {
        display: block;
        color: #8a94a6;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .credit-hours strong {
        display: block;
        color: #212529;
        font-size: 14px;
        font-weight: 800;
    }

    .empty-card {
        text-align: center;
        background: white;
        padding: 70px 25px;
        border-radius: 22px;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .05);
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        border-radius: 21px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .empty-card h3 {
        font-weight: 800;
        margin-bottom: 8px;
        color: #17233c;
    }

    .empty-card p {
        color: #6c757d;
        margin: 0;
    }

    .bottom-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .action-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .teacher-subjects-page {
            padding: 20px 0 40px;
        }

        .subjects-hero {
            padding: 25px 20px;
        }

        .hero-icon {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }

        .subjects-hero h1 {
            font-size: 1.6rem;
        }

        .subjects-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .subject-count {
            align-self: flex-start;
        }

        .bottom-actions {
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            width: 100%;
        }
    }

</style>