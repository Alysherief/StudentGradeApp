@model StudentGradeApp.ViewModels.TeacherStudentsViewModel

@{
    ViewData["Title"] = "My Students";
}

<style>
    .students-page {
        min-height: 75vh;
        padding-top: 35px;
        padding-bottom: 60px;
    }

    .page-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 20px;
        padding: 32px 35px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.15);
    }

        .page-header h1 {
            font-weight: 750;
            margin-bottom: 8px;
        }

        .page-header p {
            margin: 0;
            opacity: 0.88;
        }

    .control-card {
        border: none;
        border-radius: 18px;
        background: white;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.06);
        margin-bottom: 28px;
    }

        .control-card .card-body {
            padding: 25px;
        }

    .control-label {
        font-weight: 650;
        margin-bottom: 9px;
        color: #212529;
    }

    .form-select {
        border-radius: 11px;
        padding: 11px 14px;
        border: 1px solid #dee2e6;
    }

        .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }

    .btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .students-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.06);
    }

    .students-card-header {
        background: white;
        border-bottom: 1px solid #edf0f3;
        padding: 22px 25px;
    }

        .students-card-header h4 {
            font-weight: 700;
            margin: 0;
        }

        .students-card-header p {
            margin: 5px 0 0;
            color: #6c757d;
            font-size: 0.92rem;
        }

    .student-table {
        margin-bottom: 0;
    }

        .student-table thead th {
            background: #f8f9fc;
            border-bottom: 1px solid #e9ecef;
            color: #6c757d;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 700;
            padding: 15px 20px;
            white-space: nowrap;
        }

        .student-table tbody td {
            padding: 17px 20px;
            vertical-align: middle;
            border-color: #f0f2f5;
        }

        .student-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .student-table tbody tr:hover {
                background-color: #f8faff;
            }

    .student-avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eaf2ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 12px;
    }

    .student-name {
        font-weight: 650;
        color: #212529;
    }

    .student-email {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .grade-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        padding: 7px 12px;
        border-radius: 9px;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .grade-good {
        background: #e8f7ee;
        color: #198754;
    }

    .grade-average {
        background: #fff4d6;
        color: #997404;
    }

    .grade-low {
        background: #fdeaea;
        color: #dc3545;
    }

    .grade-none {
        background: #f1f3f5;
        color: #6c757d;
    }

    .profile-btn {
        border-radius: 9px;
        padding: 7px 13px;
        font-size: 0.88rem;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6c757d;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #f1f5ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .subject-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 9px;
        background: #eef4ff;
        color: #0d6efd;
        font-size: 0.85rem;
        font-weight: 650;
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 25px;
        }

        .students-page {
            padding-top: 20px;
        }

        .student-table {
            min-width: 750px;
        }

        .table-responsive {
            border-radius: 0 0 18px 18px;
        }
    }
</style>

<div class="container students-page">

    <!-- Header -->
    <div class="page-header">

        <div class="d-flex align-items-center gap-3">

            <div>
                <h1>
                    <i class="bi bi-people-fill me-2"></i>
                    My Students
                </h1>

                <p>
                    View the students enrolled in the subjects you teach.
                </p>
            </div>

        </div>

    </div>


    <!-- Subject Selection -->
    <div class="card control-card">

        <div class="card-body">

            <div class="row align-items-end g-3">

                <div class="col-md-8">

                    <label class="control-label">
                        <i class="bi bi-book me-1"></i>
                        Select Subject
                    </label>

                    <select id="subjectSelect"
                            class="form-select">

                        <option value="">
                            -- Select a subject --
                        </option>

                        @foreach (var subject in Model.Subjects)
                        {
                            if (Model.SelectedSubjectId == subject.Id)
                            {
                                <option value="@subject.Id" selected>
                                    @subject.Code - @subject.Name
                                </option>
                            }
                            else
                            {
                                <option value="@subject.Id">
                                    @subject.Code - @subject.Name
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-4">

                    <button type="button"
                            id="viewStudentsBtn"
                            class="btn btn-primary w-100">

                        <i class="bi bi-people me-2"></i>
                        View Students

                    </button>

                </div>

            </div>

        </div>

    </div>


    @if (Model.SelectedSubjectId.HasValue)
    {
        var selectedSubject = Model.Subjects
            .FirstOrDefault(s => s.Id == Model.SelectedSubjectId);

        <!-- Selected Subject -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h4 class="fw-bold mb-1">
                    Students
                </h4>

                @if (selectedSubject != null)
                {
                    <span class="subject-badge">
                        <i class="bi bi-book-fill"></i>
                        @selectedSubject.Code - @selectedSubject.Name
                    </span>
                }

            </div>

            <div class="text-muted small">

                @Model.Students.Count student(s)

            </div>

        </div>


        <!-- Students Table -->
        <div class="card students-card">

            <div class="students-card-header">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div>
                        <h4>
                            Enrolled Students
                        </h4>

                        <p>
                            Student grades shown below are for this subject only.
                        </p>
                    </div>


                    <!-- Sorting -->
                    <div>

                        <form method="get"
                              asp-action="Students"
                              asp-controller="Teacher">

                            <input type="hidden"
                                   name="subjectId"
                                   value="@Model.SelectedSubjectId" />

                            <select name="sortOrder"
                                    class="form-select form-select-sm"
                                    onchange="this.form.submit()">

                                @if (ViewBag.SortOrder == "gradeDesc")
                                {
                                    <option value="gradeDesc" selected>
                                        Highest Grade
                                    </option>
                                }
                                else
                                {
                                    <option value="gradeDesc">
                                        Highest Grade
                                    </option>
                                }

                                @if (ViewBag.SortOrder == "gradeAsc")
                                {
                                    <option value="gradeAsc" selected>
                                        Lowest Grade
                                    </option>
                                }
                                else
                                {
                                    <option value="gradeAsc">
                                        Lowest Grade
                                    </option>
                                }

                                @if (ViewBag.SortOrder == "nameDesc")
                                {
                                    <option value="nameDesc" selected>
                                        Name Z-A
                                    </option>
                                }
                                else
                                {
                                    <option value="nameDesc">
                                        Name Z-A
                                    </option>
                                }

                                @if (ViewBag.SortOrder == "name")
                                {
                                    <option value="name" selected>
                                        Name A-Z
                                    </option>
                                }
                                else
                                {
                                    <option value="name">
                                        Name A-Z
                                    </option>
                                }

                            </select>

                        </form>

                    </div>

                </div>

            </div>


            @if (Model.Students != null && Model.Students.Any())
            {
                <div class="table-responsive">

                    <table class="table student-table">

                        <thead>

                            <tr>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Subject Grade
                                </th>

                                <th>
                                    Components
                                </th>

                                <th class="text-end">
                                    Profile
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var student in Model.Students)
                            {
                                var gradeClass = "grade-none";

                                if (student.GradeCount > 0)
                                {
                                    if (student.AverageGrade >= 70)
                                    {
                                        gradeClass = "grade-good";
                                    }
                                    else if (student.AverageGrade >= 50)
                                    {
                                        gradeClass = "grade-average";
                                    }
                                    else
                                    {
                                        gradeClass = "grade-low";
                                    }
                                }

                                var initials = "";

                                if (!string.IsNullOrWhiteSpace(student.FullName))
                                {
                                    var nameParts = student.FullName
                                        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                    if (nameParts.Length >= 2)
                                    {
                                        initials =
                                            $"{nameParts[0][0]}{nameParts[^1][0]}";
                                    }
                                    else
                                    {
                                        initials =
                                            nameParts[0][0].ToString();
                                    }

                                    initials = initials.ToUpper();
                                }

                                <tr>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="student-avatar">
                                                @initials
                                            </div>

                                            <div>
                                                <div class="student-name">
                                                    @student.FullName
                                                </div>

                                                <div class="student-email">
                                                    Student
                                                </div>
                                            </div>

                                        </div>

                                    </td>


                                    <td>
                                        <span class="student-email">
                                            @student.Email
                                        </span>
                                    </td>


                                    <td>

                                        @if (student.GradeCount > 0)
                                        {
                                            <span class="grade-badge @gradeClass">
                                                @student.AverageGrade.ToString("0.##")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="grade-badge grade-none">
                                                Not graded
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (student.GradeCount > 0)
                                        {
                                            <span class="text-muted">
                                                @student.GradeCount graded
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No grades yet
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <a asp-controller="Teacher"
                                           asp-action="StudentProfile"
                                           asp-route-id="@student.StudentId"
                                           class="btn btn-outline-primary profile-btn">

                                            <i class="bi bi-person me-1"></i>
                                            View Profile

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5 class="fw-bold">
                        No Students Found
                    </h5>

                    <p class="mb-0">
                        There are currently no approved students enrolled
                        in this subject.
                    </p>

                </div>
            }

        </div>
    }
    else
    {
        <!-- No Subject Selected -->
        <div class="card students-card">

            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-book"></i>
                </div>

                <h5 class="fw-bold">
                    Select a Subject
                </h5>

                <p class="mb-0">
                    Choose one of your subjects above to view its enrolled students
                    and their grades for that subject.
                </p>

            </div>

        </div>
    }

</div>


<script>

    document.getElementById("viewStudentsBtn")
        .addEventListener("click", function() {

            const subjectId =
                document.getElementById("subjectSelect").value;

            if (!subjectId) {
                alert("Please select a subject first.");
                return;
            }

            window.location.href =
                '@Url.Action("Students", "Teacher")'
                + '?subjectId='
                + subjectId;

        });

</script>