@using StudentGradeApp.Models

@{
    ViewData["Title"] = "Manage Grades";

    var subjects = ViewBag.Subjects as List<Subject> ?? new List<Subject>();
    var components = ViewBag.Components as List<GradeComponent> ?? new List<GradeComponent>();
    var students = ViewBag.Students as List<StudentSubject> ?? new List<StudentSubject>();
    var existingGrades = ViewBag.ExistingGrades as List<StudentGrade> ?? new List<StudentGrade>();

    var selectedSubject = ViewBag.SelectedSubject as Subject;
    var selectedComponent = ViewBag.SelectedComponent as GradeComponent;
}

<div class="container grades-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show success-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show success-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="grades-header">

        <div class="header-content">

            <div class="header-icon">
                <i class="bi bi-journal-check"></i>
            </div>

            <div>
                <h1>Manage Grades</h1>

                <p>
                    Enter, update and manage grades for your students.
                </p>
            </div>

        </div>

    </div>

    <div class="selection-card">

        <div class="selection-title">

            <div class="selection-icon">
                <i class="bi bi-funnel-fill"></i>
            </div>

            <div>
                <h3>Select Grade Component</h3>

                <p>
                    Choose a subject and the assessment you want to grade.
                </p>
            </div>

        </div>

        <div class="row g-4">

            <div class="col-md-6">

                <label class="form-label">
                    Subject
                </label>

                <select class="form-select"
                        onchange="changeSubject(this.value)">

                    <option value="">
                        Select a subject
                    </option>

                    @foreach (var subject in subjects)
                    {
                        <option value="@subject.Id"
                                selected="@(selectedSubject != null && selectedSubject.Id == subject.Id)">
                            @subject.Code - @subject.Name
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-6">

                <label class="form-label">
                    Grade Component
                </label>

                <select class="form-select"
                        onchange="changeComponent(this.value)"
                        disabled="@(selectedSubject == null)">

                    <option value="">
                        Select a component
                    </option>

                    @foreach (var component in components)
                    {
                        <option value="@component.Id"
                                selected="@(selectedComponent != null && selectedComponent.Id == component.Id)">
                            @component.Name (@component.WeightPercentage%)
                        </option>
                    }

                </select>

            </div>

        </div>

    </div>

    @if (selectedSubject == null)
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="bi bi-book"></i>
            </div>

            <h3>Select a Subject</h3>

            <p>
                Choose one of your subjects above to begin entering grades.
            </p>

        </div>
    }
    else if (selectedComponent == null)
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="bi bi-clipboard-check"></i>
            </div>

            <h3>Select a Grade Component</h3>

            <p>
                Choose a quiz, assignment, exam or other assessment
                from the dropdown above.
            </p>

        </div>
    }
    else if (!students.Any())
    {
        <div class="empty-state">

            <div class="empty-icon warning-icon">
                <i class="bi bi-people"></i>
            </div>

            <h3>No Approved Students</h3>

            <p>
                There are currently no approved students enrolled
                in this subject.
            </p>

        </div>
    }
    else
    {
        <form asp-controller="Teacher"
              asp-action="SaveGrades"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="subjectId"
                   value="@selectedSubject.Id" />

            <input type="hidden"
                   name="componentId"
                   value="@selectedComponent.Id" />

            <div class="grade-card">

                <div class="grade-card-header">

                    <div class="component-details">

                        <div class="component-icon">
                            <i class="bi bi-clipboard-data"></i>
                        </div>

                        <div>

                            <h3>
                                @selectedComponent.Name
                            </h3>

                            <p>
                                @selectedSubject.Code
                                ·
                                @selectedSubject.Name
                            </p>

                        </div>

                    </div>

                    <div class="component-badges">

                        <span class="weight-badge">
                            <i class="bi bi-percent"></i>
                            @selectedComponent.WeightPercentage% Weight
                        </span>

                        <span class="max-badge">
                            Max @selectedComponent.MaxGrade
                        </span>

                    </div>

                </div>

                <div class="students-header">

                    <div>
                        Student
                    </div>

                    <div>
                        Grade
                    </div>

                </div>

                @foreach (var enrollment in students)
                {
                    if (enrollment == null)
                    {
                        continue;
                    }

                    var existingGrade = existingGrades
                        .Where(g => g != null)
                        .FirstOrDefault(g =>
                            g.StudentId == enrollment.StudentId);

                    var studentName = enrollment.Student?.FullName;

                    if (string.IsNullOrWhiteSpace(studentName))
                    {
                        studentName = enrollment.Student?.UserName;
                    }

                    if (string.IsNullOrWhiteSpace(studentName))
                    {
                        studentName = "Unknown Student";
                    }

                    var studentEmail = enrollment.Student?.Email;

                    var avatarLetter = "U";

                    if (!string.IsNullOrWhiteSpace(studentName))
                    {
                        avatarLetter = studentName
                            .Trim()
                            .Substring(0, 1)
                            .ToUpper();
                    }

                    <div class="student-row">

                        <div class="student-info">

                            <div class="student-avatar">
                                @avatarLetter
                            </div>

                            <div>

                                <div class="student-name">
                                    @studentName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(studentEmail))
                                {
                                    <div class="student-email">
                                        @studentEmail
                                    </div>
                                }

                            </div>

                        </div>

                        <div class="grade-entry">

                            <div class="input-group grade-input-group">

                                <input type="number"
                                       class="form-control grade-input"
                                       name="grades[@enrollment.StudentId]"
                                       value="@(existingGrade != null ? existingGrade.Grade.ToString("0.##") : "")"
                                       min="0"
                                       max="@selectedComponent.MaxGrade"
                                       step="0.01"
                                       placeholder="0" />

                                <span class="input-group-text">
                                    / @selectedComponent.MaxGrade
                                </span>

                            </div>

                        </div>

                    </div>
                }

                <div class="save-section">

                    <div class="save-info">

                        <i class="bi bi-info-circle"></i>

                        Enter the grades and click Save Grades.

                    </div>

                    <button type="submit"
                            class="btn btn-primary save-btn">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        Save Grades

                    </button>

                </div>

            </div>

        </form>
    }

</div>

<script>

    function changeSubject(subjectId) {

        if (!subjectId) {
            window.location.href = '@Url.Action("Grades", "Teacher")';
            return;
        }

        window.location.href =
            '@Url.Action("Grades", "Teacher")'
            + '?subjectId='
            + encodeURIComponent(subjectId);
    }

    function changeComponent(componentId) {

        if (!componentId) {
            return;
        }

        const subjectId = '@(selectedSubject?.Id ?? 0)';

        if (!subjectId || subjectId === "0") {
            return;
        }

        window.location.href =
            '@Url.Action("Grades", "Teacher")'
            + '?subjectId='
            + encodeURIComponent(subjectId)
            + '&componentId='
            + encodeURIComponent(componentId);
    }

</script>

<style>

    .grades-page {
        padding: 35px 0 60px;
    }

    .success-alert {
        border-radius: 14px;
        padding: 15px 18px;
        margin-bottom: 25px;
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,.05);
    }

    .grades-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(13,110,253,.18);
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-icon {
        width: 65px;
        height: 65px;
        border-radius: 19px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
        flex-shrink: 0;
    }

    .grades-header h1 {
        font-weight: 800;
        margin: 0 0 7px;
        font-size: 2rem;
    }

    .grades-header p {
        margin: 0;
        opacity: .9;
        font-size: 15px;
    }

    .selection-card {
        background: white;
        border-radius: 22px;
        padding: 28px;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        margin-bottom: 25px;
    }

    .selection-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 25px;
    }

    .selection-icon {
        width: 45px;
        height: 45px;
        border-radius: 13px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .selection-title h3 {
        font-size: 1.15rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .selection-title p {
        margin: 0;
        color: #6c757d;
        font-size: 13px;
    }

    .form-label {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .form-select {
        border-radius: 12px;
        padding: 12px 14px;
        min-height: 48px;
    }

        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.12);
        }

    .empty-state {
        background: white;
        border-radius: 22px;
        padding: 60px 25px;
        text-align: center;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        border-radius: 21px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 31px;
    }

    .warning-icon {
        background: #fff4df;
        color: #f59f00;
    }

    .empty-state h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #6c757d;
        margin: 0;
    }

    .grade-card {
        background: white;
        border-radius: 22px;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .grade-card-header {
        padding: 24px 28px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .component-details {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .component-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .component-details h3 {
        font-size: 1.2rem;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .component-details p {
        margin: 0;
        color: #6c757d;
        font-size: 13px;
    }

    .component-badges {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .weight-badge,
    .max-badge {
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .weight-badge {
        background: #f0f4f9;
        color: #495057;
    }

    .max-badge {
        background: #e8f1ff;
        color: #0d6efd;
    }

    .students-header {
        display: grid;
        grid-template-columns: 1fr 260px;
        padding: 13px 28px;
        background: #f8f9fb;
        color: #6c757d;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .student-row {
        display: grid;
        grid-template-columns: 1fr 260px;
        align-items: center;
        gap: 20px;
        padding: 17px 28px;
        border-bottom: 1px solid #f0f1f3;
        transition: background .2s ease;
    }

        .student-row:hover {
            background: #fafcff;
        }

        .student-row:last-of-type {
            border-bottom: none;
        }

    .student-info {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .student-avatar {
        width: 43px;
        height: 43px;
        border-radius: 13px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 16px;
        flex-shrink: 0;
    }

    .student-name {
        font-weight: 700;
        color: #212529;
    }

    .student-email {
        font-size: 12px;
        color: #6c757d;
        margin-top: 2px;
    }

    .grade-entry {
        display: flex;
        justify-content: flex-start;
    }

    .grade-input-group {
        max-width: 210px;
    }

    .grade-input {
        border-radius: 10px 0 0 10px !important;
        padding: 10px 12px;
        text-align: center;
        font-weight: 700;
        min-height: 44px;
    }

        .grade-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.12);
        }

    .grade-input-group .input-group-text {
        border-radius: 0 10px 10px 0;
        background: #f8f9fa;
        font-weight: 700;
        color: #6c757d;
    }

    .save-section {
        padding: 22px 28px;
        background: #fafbfc;
        border-top: 1px solid #edf0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .save-info {
        color: #6c757d;
        font-size: 13px;
    }

        .save-info i {
            color: #0d6efd;
            margin-right: 5px;
        }

    .save-btn {
        border-radius: 12px;
        padding: 12px 25px;
        font-weight: 700;
        box-shadow: 0 5px 15px rgba(13,110,253,.18);
    }

        .save-btn:hover {
            transform: translateY(-1px);
        }

    @@media (max-width: 767px) {

        .grades-page {
            padding: 20px 0 40px;
        }

        .grades-header {
            padding: 26px 22px;
            border-radius: 20px;
        }

        .header-content {
            align-items: flex-start;
        }

        .header-icon {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }

        .grades-header h1 {
            font-size: 1.6rem;
        }

        .selection-card {
            padding: 22px;
        }

        .grade-card-header {
            padding: 20px;
            flex-direction: column;
            align-items: flex-start;
        }

        .component-badges {
            justify-content: flex-start;
        }

        .students-header {
            grid-template-columns: 1fr 130px;
            padding: 12px 18px;
        }

        .student-row {
            grid-template-columns: 1fr 130px;
            padding: 15px 18px;
            gap: 10px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
        }

        .student-name {
            font-size: 14px;
        }

        .student-email {
            display: none;
        }

        .grade-input-group {
            max-width: 130px;
        }

        .save-section {
            padding: 20px;
            flex-direction: column;
            align-items: stretch;
        }

        .save-btn {
            width: 100%;
        }
    }

</style>