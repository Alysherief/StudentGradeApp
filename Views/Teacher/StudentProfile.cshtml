@model StudentGradeApp.Models.AppUser

@{
    ViewData["Title"] = "Student Profile";
}

<style>
    .profile-page {
        padding: 35px 0 60px;
    }

    .profile-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 22px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(13, 110, 253, 0.18);
    }

    .profile-avatar {
        width: 85px;
        height: 85px;
        border-radius: 22px;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin-bottom: 20px;
    }

    .profile-header h1 {
        font-weight: 800;
        margin-bottom: 5px;
    }

    .profile-header p {
        margin-bottom: 0;
        opacity: .85;
    }

    .info-card {
        background: white;
        border-radius: 18px;
        border: 1px solid #edf0f4;
        box-shadow: 0 8px 25px rgba(0,0,0,.06);
        padding: 25px;
    }

    .info-item {
        padding: 18px 0;
        border-bottom: 1px solid #edf0f4;
    }

        .info-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .info-label {
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: 16px;
        font-weight: 600;
    }
</style>

<div class="container profile-page">

    <div class="profile-header">

        <div class="profile-avatar">
            <i class="bi bi-person-fill"></i>
        </div>

        <h1>
            @Model.FullName
        </h1>

        <p>
            Student Profile
        </p>

    </div>


    <div class="row g-4">

        <div class="col-lg-8">

            <div class="info-card">

                <h4 class="fw-bold mb-3">
                    Personal Information
                </h4>


                <div class="info-item">

                    <div class="info-label">
                        Full Name
                    </div>

                    <div class="info-value">
                        @Model.FullName
                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Email Address
                    </div>

                    <div class="info-value">
                        @Model.Email
                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Username
                    </div>

                    <div class="info-value">
                        @Model.UserName
                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="info-card">

                <h5 class="fw-bold mb-3">
                    Student Account
                </h5>

                <p class="text-muted">
                    This student is enrolled in one or more
                    subjects that you teach.
                </p>

                <a asp-controller="Teacher"
                   asp-action="Students"
                   class="btn btn-outline-primary w-100">

                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Students

                </a>

            </div>

        </div>

    </div>

</div>