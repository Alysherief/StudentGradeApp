@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-page {
        min-height: 80vh;
    }

    .dashboard-hero {
        border-radius: 20px;
        padding: 35px;
        margin-bottom: 30px;
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10);
    }

    .dashboard-hero h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .dashboard-hero p {
        margin-bottom: 0;
        opacity: 0.9;
    }

    .dashboard-card {
        border: none;
        border-radius: 18px;
        transition: all 0.25s ease;
        overflow: hidden;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12) !important;
    }

    .dashboard-card .card-body {
        padding: 28px;
    }

    .dashboard-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        margin: 0 auto 18px auto;
        background-color: #eef4ff;
    }

    .dashboard-card h4,
    .dashboard-card h3 {
        font-weight: 650;
    }

    .dashboard-card p {
        color: #6c757d;
        min-height: 48px;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 18px;
    }

    .logout-container {
        margin-top: 40px;
        padding-top: 25px;
        border-top: 1px solid #e9ecef;
    }

    .quick-action {
        text-decoration: none;
    }
</style>


@* =========================================================
   ADMIN DASHBOARD
   ========================================================= *@

@if (User.IsInRole("Admin"))
{
    ViewData["Title"] = "Admin Dashboard";

    <div class="container dashboard-page mt-5">

        <div class="dashboard-hero">
            <h1>Admin Dashboard</h1>
            <p>
                Welcome back, @User.Identity?.Name.
                Manage your university grade portal from here.
            </p>
        </div>

        <h4 class="section-title">Account Management</h4>

        <div class="row g-4">

            <!-- Teachers -->
            <div class="col-md-4">
                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <div class="dashboard-icon">
                            👨‍🏫
                        </div>

                        <h4>Teachers</h4>

                        <p>
                            Create, edit, and manage teacher accounts.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="ManageTeachers"
                           class="btn btn-primary w-100">
                            Manage Teachers
                        </a>

                    </div>
                </div>
            </div>

            <!-- Students -->
            <div class="col-md-4">
                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <div class="dashboard-icon">
                            👨‍🎓
                        </div>

                        <h4>Students</h4>

                        <p>
                            Create, edit, and manage student accounts.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="ManageStudents"
                           class="btn btn-primary w-100">
                            Manage Students
                        </a>

                    </div>
                </div>
            </div>

            <!-- Subjects -->
            <div class="col-md-4">
                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <div class="dashboard-icon">
                            📚
                        </div>

                        <h4>Subjects</h4>

                        <p>
                            Create and manage university subjects and credit hours.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="ManageSubjects"
                           class="btn btn-primary w-100">
                            Manage Subjects
                        </a>

                    </div>
                </div>
            </div>

        </div>


        <h4 class="section-title mt-5">Academic Management</h4>

        <div class="row g-4">

            <!-- Subject Requests -->
            <div class="col-md-4">
                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <div class="dashboard-icon">
                            📋
                        </div>

                        <h4>Subject Requests</h4>

                        <p>
                            Review and approve student subject selections.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="SubjectRequests"
                           class="btn btn-warning w-100">
                            Review Requests
                        </a>

                    </div>
                </div>
            </div>

            <!-- Assign Teachers -->
            <div class="col-md-4">
                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <div class="dashboard-icon">
                            🔗
                        </div>

                        <h4>Assign Teachers</h4>

                        <p>
                            Assign teachers to the subjects they will teach.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="AssignTeacher"
                           class="btn btn-success w-100">
                            Assign Teachers
                        </a>

                    </div>
                </div>
            </div>

            <!-- Grade Components -->
            <div class="col-md-4">
                <div class="card dashboard-card shadow-sm h-100">
                    <div class="card-body text-center">

                        <div class="dashboard-icon">
                            📝
                        </div>

                        <h4>Grade Components</h4>

                        <p>
                            Manage quizzes, assignments, exams, and other grades.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="GradeComponents"
                           class="btn btn-success w-100">
                            Manage Grades
                        </a>

                    </div>
                </div>
            </div>

        </div>


        <div class="logout-container text-center">

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger px-4">
                    Logout
                </button>

            </form>

        </div>

    </div>
}


