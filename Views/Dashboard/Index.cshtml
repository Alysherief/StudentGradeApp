@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-page {
        min-height: 80vh;
        padding-bottom: 60px;
    }

    .dashboard-hero {
        border-radius: 24px;
        padding: 38px 40px;
        margin-bottom: 35px;
        background: linear-gradient(135deg, #0d6efd 0%, #4f8dfd 100%);
        color: white;
        box-shadow: 0 15px 35px rgba(13, 110, 253, 0.18);
    }

        .dashboard-hero h1 {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .dashboard-hero p {
            margin: 0;
            opacity: 0.9;
            font-size: 15px;
        }

    .section-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #172b4d;
        margin-bottom: 18px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .dashboard-card {
        border: 1px solid #edf0f5;
        border-radius: 22px;
        background: white;
        overflow: hidden;
        transition: all 0.25s ease;
        height: 100%;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            border-color: #dce7fa;
            box-shadow: 0 15px 35px rgba(30, 60, 90, 0.10) !important;
        }

        .dashboard-card .card-body {
            padding: 30px;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

    .dashboard-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 20px;
        background: #edf4ff;
        color: #0d6efd;
    }

    .dashboard-card h3,
    .dashboard-card h4 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #172b4d;
        margin-bottom: 8px;
    }

    .dashboard-card p {
        color: #6c757d;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 25px;
        flex: 1;
    }

    .dashboard-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
        border: none;
        transition: all 0.2s ease;
    }

        .dashboard-btn:hover {
            transform: translateY(-1px);
        }

    .account-section {
        margin-top: 42px;
    }

    .account-card .dashboard-icon {
        background: #f0f7ff;
        color: #0d6efd;
    }

    .logout-card .dashboard-icon {
        background: #fff1f1;
        color: #dc3545;
    }

    .logout-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .dashboard-page {
            padding-bottom: 40px;
        }

        .dashboard-hero {
            padding: 28px 22px;
            border-radius: 20px;
        }

            .dashboard-hero h1 {
                font-size: 1.65rem;
            }

        .dashboard-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .dashboard-card .card-body {
            padding: 24px;
        }
    }
</style>


@if (User.IsInRole("Admin"))
{
    ViewData["Title"] = "Admin Dashboard";

    <div class="container dashboard-page mt-5">

        <div class="dashboard-hero">
            <h1>Admin Dashboard</h1>
            <p>
                Welcome back, @User.Identity?.Name.
                Manage users, subjects, and academic activities from here.
            </p>
        </div>

        <h4 class="section-title">Account Management</h4>

        <div class="dashboard-grid">

            <div class="card dashboard-card shadow-sm">
                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <h4>Teachers</h4>

                    <p>
                        Create, edit, and manage teacher accounts.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageTeachers"
                       class="btn btn-primary dashboard-btn w-100">
                        Manage Teachers
                    </a>

                </div>
            </div>

            <div class="card dashboard-card shadow-sm">
                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <h4>Students</h4>

                    <p>
                        Create, edit, and manage student accounts.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageStudents"
                       class="btn btn-primary dashboard-btn w-100">
                        Manage Students
                    </a>

                </div>
            </div>

            <div class="card dashboard-card shadow-sm">
                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>

                    <h4>Subjects</h4>

                    <p>
                        Create and manage university subjects and credit hours.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageSubjects"
                       class="btn btn-primary dashboard-btn w-100">
                        Manage Subjects
                    </a>

                </div>
            </div>

        </div>

        <h4 class="section-title mt-5">Academic Management</h4>

        <div class="dashboard-grid">

            <div class="card dashboard-card shadow-sm">
                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-clipboard-check-fill"></i>
                    </div>

                    <h4>Subject Requests</h4>

                    <p>
                        Review and approve student subject selections.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="SubjectRequests"
                       class="btn btn-warning dashboard-btn w-100">
                        Review Requests
                    </a>

                </div>
            </div>

            <div class="card dashboard-card shadow-sm">
                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>

                    <h4>Assign Teachers</h4>

                    <p>
                        Assign teachers to the subjects they will teach.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AssignTeacher"
                       class="btn btn-success dashboard-btn w-100">
                        Assign Teachers
                    </a>

                </div>
            </div>

            <div class="card dashboard-card shadow-sm">
                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <h4>Grade Components</h4>

                    <p>
                        Manage quizzes, assignments, exams, and other grades.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="GradeComponents"
                       class="btn btn-success dashboard-btn w-100">
                        Manage Grades
                    </a>

                </div>
            </div>

        </div>

        <div class="account-section">

            <h4 class="section-title">Account</h4>

            <div class="dashboard-grid">

                <div class="card dashboard-card account-card shadow-sm">
                    <div class="card-body">

                        <div class="dashboard-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <h3>My Profile</h3>

                        <p>
                            View and manage your personal account information.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="btn btn-info dashboard-btn w-100">
                            View Profile
                        </a>

                    </div>
                </div>

                <div class="card dashboard-card logout-card shadow-sm">
                    <div class="card-body">

                        <div class="dashboard-icon">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>

                        <h3>Logout</h3>

                        <p>
                            Sign out of your administrator account securely.
                        </p>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger logout-btn w-100">
                                Logout
                            </button>

                        </form>

                    </div>
                </div>

            </div>

        </div>

    </div>
}


