@{
    ViewData["Title"] = "Dashboard";
}

<style>

    .dashboard-page {
        min-height: 80vh;
        padding-bottom: 60px;
    }

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 42px 45px;
        margin-bottom: 35px;
        background: linear-gradient(135deg, #0b5ed7 0%, #0d6efd 45%, #6ea8fe 100%);
        color: white;
        box-shadow: 0 20px 45px rgba(13, 110, 253, 0.22);
        min-height: 220px;
        display: flex;
        align-items: center;
    }

        .dashboard-hero::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            right: -80px;
            top: -140px;
        }

        .dashboard-hero::after {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.07);
            right: 190px;
            bottom: -140px;
        }

    .dashboard-hero-content {
        position: relative;
        z-index: 2;
        max-width: 750px;
    }

    .dashboard-welcome {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        margin-bottom: 15px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.18);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .6px;
    }

        .dashboard-welcome i {
            font-size: 14px;
        }

    .dashboard-hero h1 {
        font-size: 2.5rem;
        font-weight: 850;
        letter-spacing: -0.8px;
        margin-bottom: 10px;
        line-height: 1.15;
    }

        .dashboard-hero h1 span {
            font-weight: 500;
            opacity: 0.95;
        }

    .dashboard-hero p {
        margin: 0;
        opacity: 0.9;
        font-size: 16px;
        line-height: 1.6;
        max-width: 650px;
    }

    .dashboard-user-card {
        position: absolute;
        right: 45px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
        width: 175px;
        padding: 20px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(10px);
        text-align: center;
    }

    .dashboard-user-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .dashboard-user-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .7px;
        opacity: .75;
        font-weight: 700;
    }

    .dashboard-user-name {
        font-size: 15px;
        font-weight: 800;
        margin-top: 3px;
        word-break: break-word;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #172b4d;
        margin-bottom: 18px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .dashboard-card {
        border: 1px solid #edf0f5;
        border-radius: 22px;
        background: white;
        overflow: hidden;
        transition: all 0.25s ease;
        height: 100%;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            border-color: #dce7fa;
            box-shadow: 0 15px 35px rgba(30, 60, 90, 0.10) !important;
        }

        .dashboard-card .card-body {
            padding: 30px;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

    .dashboard-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 20px;
        background: #edf4ff;
        color: #0d6efd;
    }

    .dashboard-card h3,
    .dashboard-card h4 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #172b4d;
        margin-bottom: 8px;
    }

    .dashboard-card p {
        color: #6c757d;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 25px;
        flex: 1;
    }

    .dashboard-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
        border: none;
        transition: all 0.2s ease;
    }

        .dashboard-btn:hover {
            transform: translateY(-1px);
        }

    .account-section {
        margin-top: 42px;
    }

    .account-card .dashboard-icon {
        background: #f0f7ff;
        color: #0d6efd;
    }

    .logout-card .dashboard-icon {
        background: #fff1f1;
        color: #dc3545;
    }

    .logout-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .dashboard-page {
            padding-bottom: 40px;
        }

        .dashboard-hero {
            padding: 30px 24px;
            min-height: auto;
            border-radius: 22px;
        }

            .dashboard-hero h1 {
                font-size: 1.9rem;
            }

            .dashboard-hero p {
                font-size: 14px;
            }

        .dashboard-user-card {
            display: none;
        }

        .dashboard-welcome {
            font-size: 11px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .dashboard-card .card-body {
            padding: 24px;
        }
    }

</style>


@if (User.IsInRole("Admin"))
{
    ViewData["Title"] = "Admin Dashboard";

    <div class="container dashboard-page mt-5">

        <div class="dashboard-hero">

            <div class="dashboard-hero-content">

                <div class="dashboard-welcome">
                    <i class="bi bi-shield-check"></i>
                    ADMINISTRATOR PORTAL
                </div>

                <h1>
                    Welcome back,
                    <span>@User.Identity?.Name</span> 👋
                </h1>

                <p>
                    Manage users, subjects, teacher assignments, and
                    academic activities from one central dashboard.
                </p>

            </div>

            <div class="dashboard-user-card">

                <div class="dashboard-user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="dashboard-user-label">
                    Signed in as
                </div>

                <div class="dashboard-user-name">
                    @User.Identity?.Name
                </div>

            </div>

        </div>


        <h4 class="section-title">
            Account Management
        </h4>

        <div class="dashboard-grid">

            <div class="card dashboard-card shadow-sm">

                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <h4>
                        Teachers
                    </h4>

                    <p>
                        Create, edit, and manage teacher accounts.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageTeachers"
                       class="btn btn-primary dashboard-btn w-100">

                        Manage Teachers

                    </a>

                </div>

            </div>


            <div class="card dashboard-card shadow-sm">

                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <h4>
                        Students
                    </h4>

                    <p>
                        Create, edit, and manage student accounts.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageStudents"
                       class="btn btn-primary dashboard-btn w-100">

                        Manage Students

                    </a>

                </div>

            </div>


            <div class="card dashboard-card shadow-sm">

                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>

                    <h4>
                        Subjects
                    </h4>

                    <p>
                        Create and manage university subjects and credit hours.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageSubjects"
                       class="btn btn-primary dashboard-btn w-100">

                        Manage Subjects

                    </a>

                </div>

            </div>

        </div>


        <h4 class="section-title mt-5">
            Academic Management
        </h4>

        <div class="dashboard-grid">

            <div class="card dashboard-card shadow-sm">

                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-clipboard-check-fill"></i>
                    </div>

                    <h4>
                        Subject Requests
                    </h4>

                    <p>
                        Review and approve student subject selections.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="SubjectRequests"
                       class="btn btn-warning dashboard-btn w-100">

                        Review Requests

                    </a>

                </div>

            </div>


            <div class="card dashboard-card shadow-sm">

                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>

                    <h4>
                        Assign Teachers
                    </h4>

                    <p>
                        Assign teachers to the subjects they will teach.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AssignTeacher"
                       class="btn btn-success dashboard-btn w-100">

                        Assign Teachers

                    </a>

                </div>

            </div>


            <div class="card dashboard-card shadow-sm">

                <div class="card-body">

                    <div class="dashboard-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <h4>
                        Grade Components
                    </h4>

                    <p>
                        Manage quizzes, assignments, exams, and other grades.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="GradeComponents"
                       class="btn btn-success dashboard-btn w-100">

                        Manage Grades

                    </a>

                </div>

            </div>

        </div>


        <div class="account-section">

            <h4 class="section-title">
                Account
            </h4>

            <div class="dashboard-grid">

                <div class="card dashboard-card account-card shadow-sm">

                    <div class="card-body">

                        <div class="dashboard-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <h3>
                            My Profile
                        </h3>

                        <p>
                            View and manage your personal account information.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="btn btn-info dashboard-btn w-100">

                            View Profile

                        </a>

                    </div>

                </div>


                <div class="card dashboard-card logout-card shadow-sm">

                    <div class="card-body">

                        <div class="dashboard-icon">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>

                        <h3>
                            Logout
                        </h3>

                        <p>
                            Sign out of your administrator account securely.
                        </p>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger logout-btn w-100">

                                Logout

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>
}


