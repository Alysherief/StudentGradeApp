@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 mb-3"
             style="width: 75px; height: 75px;">
            <i class="bi bi-shield-check text-primary" style="font-size: 36px;"></i>
        </div>

        <h1 class="fw-bold">Privacy & Security</h1>

        <p class="text-muted fs-5">
            Your information and academic records are handled securely.
        </p>
    </div>

    <div class="row g-4">

        <!-- Personal Information -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-person-lock text-primary fs-4"></i>
                        </div>

                        <h4 class="fw-bold mb-0">Personal Information</h4>
                    </div>

                    <p class="text-muted mb-0">
                        Personal information provided through the Student Grade Portal
                        is used only for academic administration, account management,
                        and providing access to the services available within the system.
                    </p>
                </div>
            </div>
        </div>

        <!-- Academic Records -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-journal-check text-success fs-4"></i>
                        </div>

                        <h4 class="fw-bold mb-0">Academic Records</h4>
                    </div>

                    <p class="text-muted mb-0">
                        Grades, subjects, enrollment information, and transcripts are
                        protected and are only accessible to authorized users based
                        on their assigned role and permissions.
                    </p>
                </div>
            </div>
        </div>

        <!-- Account Security -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-key text-warning fs-4"></i>
                        </div>

                        <h4 class="fw-bold mb-0">Account Security</h4>
                    </div>

                    <p class="text-muted mb-0">
                        User accounts are protected through secure authentication.
                        Users should keep their passwords confidential and log out
                        when using the system on a shared or public computer.
                    </p>
                </div>
            </div>
        </div>

        <!-- Role-Based Access -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-shield-lock text-info fs-4"></i>
                        </div>

                        <h4 class="fw-bold mb-0">Role-Based Access</h4>
                    </div>

                    <p class="text-muted mb-0">
                        Access to features is controlled according to the user's role.
                        Administrators, teachers, and students only receive access to
                        the sections relevant to their responsibilities.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Important Notice -->
    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-start">
                <div class="rounded-3 bg-secondary bg-opacity-10 p-3 me-3 flex-shrink-0">
                    <i class="bi bi-info-circle text-secondary fs-4"></i>
                </div>

                <div>
                    <h4 class="fw-bold">Important Information</h4>

                    <p class="text-muted mb-2">
                        This Student Grade Portal is designed to manage academic
                        information within the university environment.
                    </p>

                    <p class="text-muted mb-0">
                        If you notice unauthorized access, incorrect academic information,
                        or any security concern, please contact the system administrator
                        or the appropriate university department.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <small class="text-muted">
            Student Grade Portal &bull; Privacy & Security
        </small>
    </div>

</div>