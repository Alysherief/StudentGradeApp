@{
    ViewData["Title"] = "Home";
}

<style>

    body {
        background-color: #f8f9fc;
    }

    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #4f8dfd 55%, #6f9ffb 100%);
        color: white;
        padding: 85px 0;
        position: relative;
        z-index: 1;
        overflow: hidden;
    }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            top: -250px;
            right: -150px;
        }

        .hero-section::after {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            background: rgba(255,255,255,0.06);
            border-radius: 50%;
            bottom: -200px;
            left: -100px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 50px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.2);
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 500;
    }

    .hero-title {
        font-size: clamp(2.5rem, 5vw, 4.2rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -1px;
    }

    .hero-text {
        font-size: 1.15rem;
        opacity: 0.9;
        max-width: 600px;
        line-height: 1.7;
    }

    .hero-login {
        border-radius: 12px;
        padding: 13px 28px;
        font-weight: 600;
    }

    .hero-register {
        border-radius: 12px;
        padding: 13px 28px;
        font-weight: 600;
    }

    .hero-panel {
        position: relative;
        z-index: 2;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(12px);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    }

    .hero-icon {
        width: 95px;
        height: 95px;
        margin: auto;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.15);
        font-size: 48px;
    }

    .section {
        padding: 75px 0;
    }

    .section-header {
        max-width: 650px;
        margin: 0 auto 45px auto;
        text-align: center;
    }

        .section-header h2 {
            font-weight: 800;
            font-size: 2.2rem;
        }

        .section-header p {
            color: #6c757d;
            font-size: 1.05rem;
        }

    .action-card {
        background: white;
        border: none;
        border-radius: 20px;
        padding: 30px;
        height: 100%;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        transition: all 0.25s ease;
    }

        .action-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.11);
        }

    .action-icon {
        width: 62px;
        height: 62px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        margin-bottom: 22px;
    }

    .action-card h4 {
        font-weight: 700;
        margin-bottom: 12px;
    }

    .action-card p {
        color: #6c757d;
        line-height: 1.65;
        min-height: 78px;
    }

    .action-card .btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .feature-section {
        background: white;
    }

    .feature-card {
        padding: 25px;
        text-align: center;
    }

    .feature-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        font-size: 30px;
    }

    .feature-card h4 {
        font-weight: 700;
    }

    .feature-card p {
        color: #6c757d;
        line-height: 1.6;
    }

    .cta-section {
        background: #111827;
        color: white;
        padding: 75px 0;
    }

        .cta-section h2 {
            font-weight: 800;
            font-size: 2.3rem;
        }

        .cta-section p {
            color: #adb5bd;
            max-width: 600px;
            margin: 15px auto 30px auto;
            font-size: 1.05rem;
        }

    .cta-button {
        border-radius: 12px;
        padding: 13px 30px;
        font-weight: 600;
    }

    .welcome-user {
        display: inline-block;
        margin-top: 15px;
        font-size: 14px;
        opacity: 0.8;
    }

</style>


<!-- =========================================================
     HERO SECTION
     ========================================================= -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7 hero-content">

                <div class="hero-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                    Student Grade Portal
                </div>

                <h1 class="hero-title mb-4">
                    Your Academic Journey,
                    <br />
                    All in One Place.
                </h1>

                <p class="hero-text mb-4">
                    Manage your subjects, grades, classes, and academic
                    progress through one simple and modern university portal.
                </p>

                <div class="d-flex flex-wrap gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="btn btn-light hero-login">

                            <i class="bi bi-speedometer2 me-2"></i>
                            Go to Dashboard

                        </a>

                        <span class="welcome-user">
                            Welcome back, @User.Identity?.Name
                        </span>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-light hero-login">

                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Login to Portal

                        </a>
                    }

                </div>

            </div>


            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="hero-panel text-center">

                    <div class="hero-icon">

                        <i class="bi bi-mortarboard-fill"></i>

                    </div>

                    <h3 class="fw-bold mt-4">
                        Academic Excellence
                    </h3>

                    <p class="mb-0 opacity-75">
                        Everything you need to manage your academic life,
                        all in one convenient place.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     QUICK ACTIONS
     ========================================================= -->
@if (User.Identity?.IsAuthenticated == true)
{
    <section class="section">

        <div class="container">

            <div class="section-header">

                <h2>Quick Actions</h2>

                <p>
                    Get where you need to go quickly.
                    Your most important tools are right here.
                </p>

            </div>


            <!-- STUDENT -->
            @if (User.IsInRole("Student"))
            {
                <div class="row g-4">

                    <!-- Grades -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-bar-chart-fill"></i>
                            </div>

                            <h4>My Grades</h4>

                            <p>
                                View your grades and track your academic
                                performance across all approved subjects.
                            </p>

                            <a asp-controller="Student"
                               asp-action="Grades"
                               class="btn btn-primary">

                                View Grades
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Subjects -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-success bg-opacity-10 text-success">
                                <i class="bi bi-book-fill"></i>
                            </div>

                            <h4>My Subjects</h4>

                            <p>
                                View the subjects that have been approved
                                by your administrator.
                            </p>

                            <a asp-controller="Student"
                               asp-action="MySubjects"
                               class="btn btn-success">

                                View Subjects
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Choose Subjects -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-journal-plus"></i>
                            </div>

                            <h4>Choose Subjects</h4>

                            <p>
                                Select your subjects and submit your
                                30-credit-hour request for approval.
                            </p>

                            <a asp-controller="Student"
                               asp-action="Subjects"
                               class="btn btn-warning">

                                Choose Subjects
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Profile -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-info bg-opacity-10 text-info">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <h4>My Profile</h4>

                            <p>
                                View and manage your personal account
                                information.
                            </p>

                            <a asp-controller="Student"
                               asp-action="Profile"
                               class="btn btn-info">

                                View Profile
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Performance -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>

                            <h4>My Performance</h4>

                            <p>
                                Monitor your academic progress and
                                overall performance.
                            </p>

                            <a asp-controller="Student"
                               asp-action="Grades"
                               class="btn btn-danger">

                                View Performance
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }


            <!-- TEACHER -->
            @if (User.IsInRole("Teacher"))
            {
                <div class="row g-4">

                    <!-- Students -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <h4>My Students</h4>

                            <p>
                                View the students assigned to your
                                classes and subjects.
                            </p>

                            <a asp-controller="Teacher"
                               asp-action="Students"
                               class="btn btn-primary">

                                View Students
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Grades -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-success bg-opacity-10 text-success">
                                <i class="bi bi-clipboard-data-fill"></i>
                            </div>

                            <h4>Manage Grades</h4>

                            <p>
                                Add, edit, and manage grades for
                                your students.
                            </p>

                            <a asp-controller="Teacher"
                               asp-action="Grades"
                               class="btn btn-success">

                                Manage Grades
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Subjects -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-book-half"></i>
                            </div>

                            <h4>My Subjects</h4>

                            <p>
                                View all subjects currently assigned
                                to you.
                            </p>

                            <a asp-controller="Teacher"
                               asp-action="Subjects"
                               class="btn btn-warning">

                                View Subjects
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Classes -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-info bg-opacity-10 text-info">
                                <i class="bi bi-easel-fill"></i>
                            </div>

                            <h4>My Classes</h4>

                            <p>
                                View and manage the classes assigned
                                to you.
                            </p>

                            <a asp-controller="Teacher"
                               asp-action="Classes"
                               class="btn btn-info">

                                View Classes
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }


            <!-- ADMIN -->
            @if (User.IsInRole("Admin"))
            {
                <div class="row g-4">

                    <!-- Teachers -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-person-workspace"></i>
                            </div>

                            <h4>Manage Teachers</h4>

                            <p>
                                Create, edit, and manage teacher
                                accounts.
                            </p>

                            <a asp-controller="Admin"
                               asp-action="ManageTeachers"
                               class="btn btn-primary">

                                Manage Teachers
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Students -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-success bg-opacity-10 text-success">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <h4>Manage Students</h4>

                            <p>
                                Create, edit, and manage student
                                accounts.
                            </p>

                            <a asp-controller="Admin"
                               asp-action="ManageStudents"
                               class="btn btn-success">

                                Manage Students
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Subjects -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-book-fill"></i>
                            </div>

                            <h4>Manage Subjects</h4>

                            <p>
                                Create subjects and manage credit
                                hours and teachers.
                            </p>

                            <a asp-controller="Admin"
                               asp-action="ManageSubjects"
                               class="btn btn-warning">

                                Manage Subjects
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Requests -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-check2-square"></i>
                            </div>

                            <h4>Subject Requests</h4>

                            <p>
                                Review student subject selections
                                and approve or reject requests.
                            </p>

                            <a asp-controller="Admin"
                               asp-action="SubjectRequests"
                               class="btn btn-danger">

                                Review Requests
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Assign Teachers -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-info bg-opacity-10 text-info">
                                <i class="bi bi-person-plus-fill"></i>
                            </div>

                            <h4>Assign Teachers</h4>

                            <p>
                                Assign teachers to the subjects
                                they teach.
                            </p>

                            <a href="#"
                               class="btn btn-info">

                                Assign Teachers
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Grades -->

                    <div class="col-md-4">

                        <div class="action-card">

                            <div class="action-icon bg-secondary bg-opacity-10 text-secondary">
                                <i class="bi bi-clipboard-check-fill"></i>
                            </div>

                            <h4>Grade Components</h4>

                            <p>
                                Manage quizzes, assignments, exams,
                                and other grading components.
                            </p>

                            <a href="#"
                               class="btn btn-secondary">

                                Manage Grades
                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </section>
}


<!-- =========================================================
     FEATURES
     ========================================================= -->

<section class="section feature-section">

    <div class="container">

        <div class="section-header">

            <h2>
                Everything You Need
            </h2>

            <p>
                A simple platform designed to make academic
                management easier for everyone.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon bg-primary bg-opacity-10 text-primary">

                        <i class="bi bi-lightning-charge-fill"></i>

                    </div>

                    <h4>Easy to Use</h4>

                    <p>
                        Quickly access grades, subjects, classes,
                        and academic information without complicated menus.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon bg-success bg-opacity-10 text-success">

                        <i class="bi bi-shield-check"></i>

                    </div>

                    <h4>Secure</h4>

                    <p>
                        Role-based access keeps student, teacher,
                        and administrator information protected.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon bg-warning bg-opacity-10 text-warning">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                    <h4>Track Performance</h4>

                    <p>
                        Keep track of academic progress and performance
                        throughout the semester.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CALL TO ACTION
     ========================================================= -->

<section class="cta-section">

    <div class="container text-center">

        <i class="bi bi-mortarboard-fill display-4"></i>

        <h2 class="mt-3">
            Your Academic Journey Starts Here
        </h2>

        <p>
            Manage your academic information from one
            convenient and easy-to-use portal.
        </p>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary cta-button">

                <i class="bi bi-box-arrow-in-right me-2"></i>
                Login to Portal

            </a>
        }
        else
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-primary cta-button">

                <i class="bi bi-speedometer2 me-2"></i>
                Open Dashboard

            </a>
        }

    </div>

</section>