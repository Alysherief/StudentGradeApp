@{
    ViewData["Title"] = "Home";
}

<style>
    body {
        background: #f8f9fc;
    }

    /* HERO */
    .home-hero {
        min-height: 620px;
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, #0d6efd 0%, #3f83f8 50%, #6ea8fe 100%);
        color: white;
        position: relative;
        overflow: hidden;
    }

        .home-hero::before {
            content: "";
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: rgba(255,255,255,0.07);
            top: -300px;
            right: -150px;
        }

        .home-hero::after {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            bottom: -250px;
            left: -150px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 70px 0;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .hero-title {
        font-size: clamp(2.8rem, 5vw, 4.5rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -2px;
        margin-bottom: 25px;
    }

    .hero-description {
        max-width: 620px;
        font-size: 1.15rem;
        line-height: 1.7;
        opacity: 0.9;
        margin-bottom: 35px;
    }

    .hero-button {
        padding: 13px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 15px;
    }

    /* HERO CARD */

    .hero-card-wrapper {
        position: relative;
        z-index: 2;
    }

    .hero-card {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        backdrop-filter: blur(15px);
        border-radius: 28px;
        padding: 35px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.15);
    }

    .hero-card-icon {
        width: 85px;
        height: 85px;
        border-radius: 24px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin-bottom: 25px;
    }

    .hero-card h3 {
        font-weight: 800;
        margin-bottom: 12px;
    }

    .hero-card p {
        opacity: 0.8;
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* FEATURES */

    .features-section {
        padding: 90px 0;
        background: white;
    }

    .section-title {
        text-align: center;
        margin-bottom: 55px;
    }

        .section-title h2 {
            font-size: 2.3rem;
            font-weight: 800;
            color: #212529;
            margin-bottom: 12px;
        }

        .section-title p {
            color: #6c757d;
            max-width: 600px;
            margin: auto;
            line-height: 1.6;
        }

    .feature-card {
        height: 100%;
        padding: 35px 28px;
        border-radius: 20px;
        background: #f8f9fc;
        border: 1px solid #edf0f4;
        text-align: center;
        transition: all 0.25s ease;
    }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            background: white;
        }

    .feature-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 22px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .feature-card h4 {
        font-weight: 700;
        margin-bottom: 12px;
    }

    .feature-card p {
        color: #6c757d;
        line-height: 1.65;
        margin-bottom: 0;
    }

    /* SIMPLE INFO */

    .info-section {
        padding: 90px 0;
        background: #f8f9fc;
    }

    .info-box {
        background: white;
        border-radius: 25px;
        padding: 50px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.06);
    }

        .info-box h2 {
            font-weight: 800;
            margin-bottom: 15px;
        }

        .info-box p {
            color: #6c757d;
            line-height: 1.7;
            max-width: 650px;
        }

    .info-list {
        margin-top: 25px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
        font-weight: 500;
    }

        .info-item i {
            color: #0d6efd;
            font-size: 20px;
        }

    /* CTA */

    .cta-section {
        background: #111827;
        color: white;
        padding: 80px 0;
        text-align: center;
    }

        .cta-section h2 {
            font-size: 2.3rem;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .cta-section p {
            color: #adb5bd;
            max-width: 600px;
            margin: 0 auto 30px;
            line-height: 1.7;
        }

    .cta-button {
        padding: 13px 30px;
        border-radius: 12px;
        font-weight: 600;
    }

    /* MOBILE */

    @@media (max-width: 991px) {

        .home-hero {
            min-height: auto;
        }

        .hero-content {
            padding: 70px 0 40px;
        }

        .hero-card-wrapper {
            padding-bottom: 70px;
        }
    }

    @@media (max-width: 767px) {

        .hero-title {
            font-size: 2.7rem;
        }

        .hero-description {
            font-size: 1rem;
        }

        .features-section,
        .info-section {
            padding: 65px 0;
        }

        .info-box {
            padding: 30px;
        }

        .section-title h2 {
            font-size: 1.9rem;
        }

        .cta-section h2 {
            font-size: 1.9rem;
        }
    }

</style>


<!-- =========================================================
     HERO
     ========================================================= -->

<section class="home-hero">

    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT -->

            <div class="col-lg-7">

                <div class="hero-content">

                    <div class="hero-badge">

                        <i class="bi bi-mortarboard-fill"></i>

                        Student Grade Portal

                    </div>


                    <h1 class="hero-title">

                        Your Academic Journey.
                        <br />

                        Made Simple.

                    </h1>


                    <p class="hero-description">

                        A simple and modern university portal designed
                        to help students, teachers, and administrators
                        manage academic information in one place.

                    </p>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-3 flex-wrap">

                            <div class="hero-badge mb-0">

                                <i class="bi bi-person-check-fill"></i>

                                Welcome back,
                                @User.Identity?.Name

                            </div>

                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-light hero-button">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Login to Portal

                        </a>
                    }

                </div>

            </div>


            <!-- RIGHT -->

            <div class="col-lg-5 hero-card-wrapper">

                <div class="hero-card">

                    <div class="hero-card-icon">

                        <i class="bi bi-mortarboard-fill"></i>

                    </div>


                    <h3>

                        Academic Excellence

                    </h3>


                    <p>

                        Keep your subjects, grades, and academic
                        progress organized through one secure
                        university portal.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     FEATURES
     ========================================================= -->

<section class="features-section">

    <div class="container">

        <div class="section-title">

            <h2>

                Everything in One Place

            </h2>

            <p>

                The portal gives every user the tools they need
                without unnecessary complexity.

            </p>

        </div>


        <div class="row g-4">


            <!-- STUDENTS -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon bg-primary bg-opacity-10 text-primary">

                        <i class="bi bi-person-fill"></i>

                    </div>


                    <h4>

                        For Students

                    </h4>


                    <p>

                        Choose your subjects, view your approved
                        courses, check individual grades, and
                        track your academic performance.

                    </p>

                </div>

            </div>


            <!-- TEACHERS -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon bg-success bg-opacity-10 text-success">

                        <i class="bi bi-person-workspace"></i>

                    </div>


                    <h4>

                        For Teachers

                    </h4>


                    <p>

                        Manage your subjects and record student
                        grades and assessment results efficiently.

                    </p>

                </div>

            </div>


            <!-- ADMIN -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon bg-warning bg-opacity-10 text-warning">

                        <i class="bi bi-shield-check"></i>

                    </div>


                    <h4>

                        For Administrators

                    </h4>


                    <p>

                        Manage users, subjects, teachers,
                        student requests, and the academic system.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     ABOUT THE PORTAL
     ========================================================= -->

<section class="info-section">

    <div class="container">

        <div class="info-box">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <h2>

                        Built for a Better Academic Experience

                    </h2>


                    <p>

                        Student Grade Portal brings the important
                        parts of university academic management
                        together in one place.

                        <br /><br />

                        Students can focus on their studies while
                        teachers and administrators can manage
                        academic information efficiently.

                    </p>


                    <div class="info-list">

                        <div class="info-item">

                            <i class="bi bi-check-circle-fill"></i>

                            Simple and easy to use

                        </div>


                        <div class="info-item">

                            <i class="bi bi-check-circle-fill"></i>

                            Secure role-based access

                        </div>


                        <div class="info-item">

                            <i class="bi bi-check-circle-fill"></i>

                            Centralized academic information

                        </div>


                        <div class="info-item">

                            <i class="bi bi-check-circle-fill"></i>

                            Designed for students, teachers, and administrators

                        </div>

                    </div>

                </div>


                <div class="col-lg-5 mt-5 mt-lg-0">

                    <div class="text-center">

                        <i class="bi bi-bar-chart-line-fill text-primary"
                           style="font-size: 100px;">
                        </i>

                        <h4 class="fw-bold mt-4">

                            Track Your Progress

                        </h4>

                        <p class="text-muted">

                            Stay informed about your academic
                            performance throughout the semester.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     CTA
     ========================================================= -->

<section class="cta-section">

    <div class="container">

        <i class="bi bi-mortarboard-fill"
           style="font-size: 55px;">
        </i>


        <h2 class="mt-4">

            Your Academic Journey Starts Here

        </h2>


        <p>

            Everything you need to manage your academic
            experience, all in one place.

        </p>


        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary cta-button">

                <i class="bi bi-box-arrow-in-right me-2"></i>

                Login to Portal

            </a>
        }
        else
        {
            <span class="text-light opacity-75">

                <i class="bi bi-check-circle-fill me-1"></i>

                You are already logged in.

            </span>
        }

    </div>

</section>