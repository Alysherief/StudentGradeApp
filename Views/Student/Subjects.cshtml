@model StudentGradeApp.ViewModels.SelectSubjectsViewModel

@{
    ViewData["Title"] = "Choose Subjects";

    var currentCreditHours = ViewBag.CurrentCreditHours != null
        ? (int)ViewBag.CurrentCreditHours
        : 0;

    var remainingCreditHours = ViewBag.RemainingCreditHours != null
        ? (int)ViewBag.RemainingCreditHours
        : Math.Max(0, 30 - currentCreditHours);
}

<style>
    .subjects-page {
        padding: 35px 0 60px;
    }

    .page-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 22px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(13, 110, 253, 0.18);
    }

        .page-header h1 {
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            margin-bottom: 0;
            opacity: 0.9;
        }

    .credit-summary {
        background: white;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        margin-bottom: 25px;
        border: 1px solid #edf0f4;
    }

    .credit-title {
        font-size: 14px;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 5px;
    }

    .credit-number {
        font-size: 32px;
        font-weight: 800;
        color: #0d6efd;
    }

    .credit-limit {
        color: #6c757d;
        font-size: 14px;
    }

    .credit-breakdown {
        margin-top: 8px;
        font-size: 13px;
        color: #6c757d;
    }

        .credit-breakdown strong {
            color: #212529;
        }

    .progress {
        height: 10px;
        border-radius: 20px;
        background-color: #e9ecef;
    }

    .progress-bar {
        border-radius: 20px;
        transition: width 0.25s ease;
    }

    .search-box {
        background: white;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        margin-bottom: 25px;
        border: 1px solid #edf0f4;
    }

    .search-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        pointer-events: none;
        z-index: 2;
    }

    .search-input {
        border-radius: 12px;
        padding: 12px 45px 12px 43px;
        border: 1px solid #dee2e6;
        font-size: 15px;
        width: 100%;
        transition: all 0.2s ease;
    }

        .search-input:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
            outline: none;
        }

    .clear-search {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #6c757d;
        display: none;
        font-size: 18px;
        padding: 5px;
        cursor: pointer;
    }

        .clear-search:hover {
            color: #212529;
        }

    .search-results {
        margin-top: 10px;
        font-size: 13px;
        color: #6c757d;
    }

    .no-search-results {
        display: none;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 18px;
        padding: 45px 25px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        margin-top: 25px;
    }

    .no-search-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 15px;
    }

    .no-search-results h4 {
        font-weight: 800;
        margin-bottom: 6px;
    }

    .no-search-results p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .subject-card {
        background: white;
        border: 2px solid #edf0f4;
        border-radius: 18px;
        padding: 22px;
        height: 100%;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .subject-card:hover {
            border-color: #b8d1ff;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .subject-card.selected {
            border-color: #0d6efd;
            background: #f5f8ff;
            box-shadow: 0 8px 22px rgba(13, 110, 253, 0.12);
        }

        .subject-card.disabled-card {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

    .subject-check {
        width: 22px;
        height: 22px;
        cursor: pointer;
    }

    .subject-code {
        display: inline-block;
        background: #eaf2ff;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 9px;
        border-radius: 7px;
        margin-bottom: 10px;
    }

    .subject-name {
        font-size: 19px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 8px;
    }

    .subject-teacher {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .credit-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f1f3f5;
        color: #495057;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .submit-section {
        background: white;
        border-radius: 18px;
        padding: 25px;
        margin-top: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
        border: 1px solid #edf0f4;
    }

    .submit-btn {
        border-radius: 12px;
        padding: 12px 28px;
        font-weight: 600;
    }

        .submit-btn:disabled {
            cursor: not-allowed;
            opacity: 0.55;
        }

    .error-box {
        border-radius: 12px;
    }

    .success-alert {
        border: none;
        border-radius: 16px;
        padding: 16px 18px;
        margin-bottom: 25px;
        background: #ecfdf3;
        color: #146c43;
    }

    .success-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #d1fae5;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 13px;
        font-size: 20px;
        flex-shrink: 0;
    }

    .selection-status {
        margin-top: 10px;
        font-size: 13px;
        font-weight: 600;
    }

        .selection-status.valid {
            color: #198754;
        }

        .selection-status.invalid {
            color: #dc3545;
        }

        .selection-status.warning {
            color: #f59f00;
        }

    @@media (max-width: 767px) {

        .subjects-page {
            padding: 20px 0 40px;
        }

        .page-header {
            padding: 25px 20px;
            border-radius: 18px;
        }

            .page-header h1 {
                font-size: 1.6rem;
            }

        .credit-summary {
            padding: 20px;
        }

        .subject-card {
            padding: 19px;
        }

        .submit-section {
            padding: 20px;
        }

        .search-box {
            padding: 15px;
        }
    }
</style>


<div class="container subjects-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert success-alert alert-dismissible fade show shadow-sm"
             role="alert">

            <div class="d-flex align-items-center">

                <div class="success-icon">
                    <i class="bi bi-check-lg"></i>
                </div>

                <div>

                    <strong>Request Submitted!</strong>

                    <div class="small">
                        @TempData["SuccessMessage"]
                    </div>

                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- PAGE HEADER -->

    <div class="page-header">

        <div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center">

            <div>

                <h1>
                    <i class="bi bi-journal-bookmark-fill me-2"></i>
                    Choose Your Subjects
                </h1>

                <p>
                    Select the subjects you want to take this semester.
                    You can select up to 30 total credit hours.
                </p>

            </div>

            <div class="mt-3 mt-md-0">

                <a asp-controller="Student"
                   asp-action="MySubjects"
                   class="btn btn-light">

                    <i class="bi bi-book me-1"></i>
                    My Subjects

                </a>

            </div>

        </div>

    </div>


    <!-- VALIDATION ERRORS -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger error-box shadow-sm">

            <div class="fw-bold mb-1">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                Please check your selection

            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- CREDIT SUMMARY -->

    <div class="credit-summary">

        <div class="row align-items-center">

            <div class="col-md-4">

                <div class="credit-title">
                    Total Credit Hours
                </div>

                <span id="creditTotal"
                      class="credit-number">

                    @currentCreditHours

                </span>

                <span class="credit-limit">
                    / 30 credits
                </span>

                <div class="credit-breakdown">

                    Already enrolled:
                    <strong id="existingCredits">
                        @currentCreditHours
                    </strong>

                    credits

                    <br />

                    Newly selected:
                    <strong id="newCredits">
                        0
                    </strong>

                    credits

                </div>

            </div>


            <div class="col-md-8 mt-3 mt-md-0">

                <div class="d-flex justify-content-between mb-2">

                    <small class="text-muted">
                        Credit Hour Progress
                    </small>

                    <small id="creditMessage"
                           class="fw-semibold text-primary">

                        @currentCreditHours / 30

                    </small>

                </div>


                <div class="progress">

                    <div id="creditProgress"
                         class="progress-bar"
                         role="progressbar"
                         style="width: @((currentCreditHours / 30.0) * 100)%;">
                    </div>

                </div>


                <div id="selectionStatus"
                     class="selection-status">

                    @if (currentCreditHours >= 30)
                    {
                        <span>
                            You have already reached the maximum of 30 credit hours.
                        </span>
                    }
                    else
                    {
                        <span>
                            You can select up to
                            <strong>@remainingCreditHours</strong>
                            more credit hours.
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- SEARCH -->

    <div class="search-box">

        <div class="search-wrapper">

            <i class="bi bi-search search-icon"></i>

            <input type="text"
                   id="subjectSearch"
                   class="search-input"
                   placeholder="Search by subject name, code or teacher..."
                   autocomplete="off" />

            <button type="button"
                    id="clearSearch"
                    class="clear-search"
                    aria-label="Clear search">

                <i class="bi bi-x-circle-fill"></i>

            </button>

        </div>

        <div id="searchResults"
             class="search-results">

            Showing all subjects

        </div>

    </div>


    <!-- FORM -->

    <form asp-controller="Student"
          asp-action="SelectSubjects"
          method="post"
          id="subjectForm">

        @Html.AntiForgeryToken()


        <!-- SUBJECTS -->

        <div class="row g-4"
             id="subjectsContainer">

            @for (int i = 0; i < Model.Subjects.Count; i++)
            {
                var subject = Model.Subjects[i];

                <div class="col-md-6 col-lg-4 subject-item"
                     data-search="@($"{subject.Name} {subject.Code} {subject.TeacherName}")">

                    <label class="subject-card d-block"
                           for="subject_@subject.SubjectId"
                           data-card-id="@subject.SubjectId">

                        <input type="hidden"
                               name="Subjects[@i].SubjectId"
                               value="@subject.SubjectId" />

                        <input type="hidden"
                               name="Subjects[@i].Name"
                               value="@subject.Name" />

                        <input type="hidden"
                               name="Subjects[@i].Code"
                               value="@subject.Code" />

                        <input type="hidden"
                               name="Subjects[@i].CreditHours"
                               value="@subject.CreditHours" />

                        <input type="hidden"
                               name="Subjects[@i].TeacherName"
                               value="@subject.TeacherName" />


                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <span class="subject-code">
                                    @subject.Code
                                </span>

                            </div>


                            <input type="checkbox"
                                   id="subject_@subject.SubjectId"
                                   name="Subjects[@i].Selected"
                                   value="true"
                                   class="form-check-input subject-check"
                                   data-credit="@subject.CreditHours"
                                   data-subject-id="@subject.SubjectId"
                            @(subject.Selected ? "checked" : "") />

                        </div>


                        <input type="hidden"
                               name="Subjects[@i].Selected"
                               value="false" />


                        <div class="subject-name">
                            @subject.Name
                        </div>


                        <div class="subject-teacher">

                            <i class="bi bi-person me-1"></i>

                            @(string.IsNullOrEmpty(subject.TeacherName)
                                ? "No teacher assigned"
                                : subject.TeacherName)

                        </div>


                        <span class="credit-badge">

                            <i class="bi bi-clock"></i>

                            @subject.CreditHours
                            credit hour@(subject.CreditHours == 1 ? "" : "s")

                        </span>

                    </label>

                </div>
            }

        </div>


        <!-- NO SEARCH RESULTS -->

        <div id="noSearchResults"
             class="no-search-results">

            <div class="no-search-icon">

                <i class="bi bi-search"></i>

            </div>

            <h4>
                No Subjects Found
            </h4>

            <p>
                No subjects match your search.
                Try a different subject name, code or teacher.
            </p>

        </div>


        <!-- SUBMIT -->

        <div class="submit-section">

            <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Ready to submit?
                    </h5>

                    <p class="text-muted mb-0">

                        Your subject selection will be sent to an
                        administrator for approval.

                    </p>

                </div>


                <button type="submit"
                        id="submitButton"
                        class="btn btn-primary submit-btn mt-3 mt-md-0"
                        disabled>

                    <i class="bi bi-send me-2"></i>

                    Submit for Approval

                </button>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener("DOMContentLoaded", function() {

            /*
             * EXISTING CREDIT HOURS
             *
             * This comes directly from the controller.
             *
             * Example:
             * Student already has 12 credits.
             *
             * We DON'T reset this to zero.
             */

            const existingCreditHours = @currentCreditHours;

            const maximumCreditHours = 30;


            const checkboxes =
                document.querySelectorAll(".subject-check");

            const totalElement =
                document.getElementById("creditTotal");

            const existingCreditsElement =
                document.getElementById("existingCredits");

            const newCreditsElement =
                document.getElementById("newCredits");

            const progressBar =
                document.getElementById("creditProgress");

            const message =
                document.getElementById("creditMessage");

            const submitButton =
                document.getElementById("submitButton");

            const selectionStatus =
                document.getElementById("selectionStatus");

            const form =
                document.getElementById("subjectForm");


            const searchInput =
                document.getElementById("subjectSearch");

            const clearSearch =
                document.getElementById("clearSearch");

            const searchResults =
                document.getElementById("searchResults");

            const noSearchResults =
                document.getElementById("noSearchResults");

            const subjectItems =
                document.querySelectorAll(".subject-item");


            /*
             * UPDATE CREDIT HOURS
             */

            function updateCredits() {

                let newlySelectedCredits = 0;


                /*
                 * Calculate only the subjects
                 * selected on THIS page.
                 */

                checkboxes.forEach(function(checkbox) {

                    if (checkbox.checked) {

                        newlySelectedCredits +=
                            parseInt(checkbox.dataset.credit) || 0;

                    }

                });


                /*
                 * Add the student's existing credits.
                 */

                const totalCreditHours =
                    existingCreditHours +
                    newlySelectedCredits;


                const remainingAfterSelection =
                    maximumCreditHours -
                    totalCreditHours;


                /*
                 * Update numbers on screen.
                 */

                existingCreditsElement.textContent =
                    existingCreditHours;

                newCreditsElement.textContent =
                    newlySelectedCredits;

                totalElement.textContent =
                    totalCreditHours;

                message.textContent =
                    totalCreditHours +
                    " / " +
                    maximumCreditHours;


                /*
                 * Update progress bar.
                 */

                const percentage =
                    Math.min(
                        (totalCreditHours / maximumCreditHours) * 100,
                        100
                    );

                progressBar.style.width =
                    percentage + "%";


                /*
                 * Update selected card appearance.
                 */

                checkboxes.forEach(function(checkbox) {

                    const card =
                        checkbox.closest(".subject-card");

                    if (!card) {
                        return;
                    }


                    if (checkbox.checked) {

                        card.classList.add("selected");

                    }
                    else {

                        card.classList.remove("selected");

                    }

                });


                /*
                 * If the student already has 30 credits.
                 */

                if (existingCreditHours >= maximumCreditHours) {

                    submitButton.disabled = true;

                    submitButton.innerHTML =
                        '<i class="bi bi-lock-fill me-2"></i>' +
                        'Maximum Credits Reached';

                    selectionStatus.textContent =
                        "You already have the maximum of 30 credit hours.";

                    selectionStatus.className =
                        "selection-status invalid";

                }


                /*
                 * If newly selected subjects push
                 * the total above 30.
                 */

                else if (totalCreditHours > maximumCreditHours) {

                    submitButton.disabled = true;

                    submitButton.innerHTML =
                        '<i class="bi bi-exclamation-circle me-2"></i>' +
                        'Too Many Credits';

                    selectionStatus.textContent =
                        "Your total would be " +
                        totalCreditHours +
                        " credits. You can only have 30.";

                    selectionStatus.className =
                        "selection-status invalid";

                }


                /*
                 * Valid selection.
                 */

                else if (newlySelectedCredits > 0) {

                    submitButton.disabled = false;

                    submitButton.innerHTML =
                        '<i class="bi bi-check-circle-fill me-2"></i>' +
                        'Submit for Approval';


                    if (totalCreditHours === maximumCreditHours) {

                        selectionStatus.textContent =
                            "You have reached the maximum of 30 credit hours.";

                    }
                    else {

                        selectionStatus.textContent =
                            "You have " +
                            remainingAfterSelection +
                            " credit hours remaining.";

                    }

                    selectionStatus.className =
                        "selection-status valid";

                }


                /*
                 * Nothing newly selected.
                 */

                else {

                    submitButton.disabled = true;

                    submitButton.innerHTML =
                        '<i class="bi bi-send me-2"></i>' +
                        'Submit for Approval';


                    if (existingCreditHours === 0) {

                        selectionStatus.textContent =
                            "Select at least one subject.";

                    }
                    else {

                        selectionStatus.textContent =
                            "You already have " +
                            existingCreditHours +
                            " credits. You can select up to " +
                            (maximumCreditHours - existingCreditHours) +
                            " more.";

                    }

                    selectionStatus.className =
                        "selection-status warning";

                }


                /*
                 * Disable subjects that would make
                 * the total exceed 30 credits.
                 */

                checkboxes.forEach(function(checkbox) {

                    /*
                     * Never disable something
                     * the student already selected.
                     */

                    if (checkbox.checked) {

                        checkbox.disabled = false;

                        return;

                    }


                    const credit =
                        parseInt(checkbox.dataset.credit) || 0;


                    const card =
                        checkbox.closest(".subject-card");


                    /*
                     * Existing credits + selected credits
                     * + this subject's credits
                     */

                    if (
                        totalCreditHours + credit >
                        maximumCreditHours
                    ) {

                        checkbox.disabled = true;

                        if (card) {

                            card.classList.add(
                                "disabled-card"
                            );

                        }

                    }
                    else {

                        checkbox.disabled = false;

                        if (card) {

                            card.classList.remove(
                                "disabled-card"
                            );

                        }

                    }

                });

            }


            /*
             * SEARCH SUBJECTS
             */

            function filterSubjects() {

                const searchTerm =
                    searchInput.value
                        .trim()
                        .toLowerCase();


                let visibleCount = 0;


                subjectItems.forEach(function(item) {

                    const searchableText =
                        item.dataset.search.toLowerCase();


                    if (
                        searchTerm === "" ||
                        searchableText.includes(searchTerm)
                    ) {

                        item.style.display = "";

                        visibleCount++;

                    }
                    else {

                        item.style.display = "none";

                    }

                });


                if (searchTerm === "") {

                    clearSearch.style.display = "none";

                    searchResults.textContent =
                        "Showing all " +
                        subjectItems.length +
                        " subjects";

                }
                else {

                    clearSearch.style.display = "block";

                    searchResults.textContent =
                        "Showing " +
                        visibleCount +
                        " of " +
                        subjectItems.length +
                        " subjects";

                }


                if (visibleCount === 0) {

                    noSearchResults.style.display =
                        "block";

                }
                else {

                    noSearchResults.style.display =
                        "none";

                }

            }


            /*
             * SEARCH INPUT
             */

            searchInput.addEventListener(
                "input",
                filterSubjects
            );


            /*
             * CLEAR SEARCH
             */

            clearSearch.addEventListener(
                "click",
                function() {

                    searchInput.value = "";

                    filterSubjects();

                    searchInput.focus();

                }
            );


            /*
             * SUBJECT CHECKBOXES
             */

            checkboxes.forEach(function(checkbox) {

                checkbox.addEventListener(
                    "change",
                    updateCredits
                );

            });


            /*
             * FORM SUBMISSION VALIDATION
             */

            form.addEventListener(
                "submit",
                function(event) {

                    let newlySelectedCredits = 0;


                    checkboxes.forEach(function(checkbox) {

                        if (checkbox.checked) {

                            newlySelectedCredits +=
                                parseInt(
                                    checkbox.dataset.credit
                                ) || 0;

                        }

                    });


                    const totalCreditHours =
                        existingCreditHours +
                        newlySelectedCredits;


                    /*
                     * No new subjects selected.
                     */

                    if (newlySelectedCredits <= 0) {

                        event.preventDefault();

                        alert(
                            "Please select at least one subject."
                        );

                        return;

                    }


                    /*
                     * Total exceeds 30.
                     */

                    if (
                        totalCreditHours >
                        maximumCreditHours
                    ) {

                        event.preventDefault();

                        alert(
                            "You cannot have more than 30 credit hours. " +
                            "You currently have " +
                            existingCreditHours +
                            " and selected " +
                            newlySelectedCredits +
                            " more."
                        );

                        return;

                    }


                    /*
                     * Enable all checkboxes before submitting.
                     *
                     * This is important because disabled inputs
                     * are NOT submitted by the browser.
                     */

                    checkboxes.forEach(function(checkbox) {

                        checkbox.disabled = false;

                    });


                    submitButton.disabled = true;

                    submitButton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2"></span>' +
                        'Submitting...';

                }
            );


            /*
             * INITIALIZE PAGE
             */

            updateCredits();

            filterSubjects();

        });

    </script>
}