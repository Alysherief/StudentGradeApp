@model StudentGradeApp.ViewModels.TeacherProfileViewModel

@{
    ViewData["Title"] = "Teacher Profile";
}

<style>
    .profile-page {
        padding: 35px 0 60px;
    }

    .profile-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 24px;
        padding: 38px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(13, 110, 253, 0.18);
    }

    .profile-avatar {
        width: 82px;
        height: 82px;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
        margin-bottom: 20px;
    }

    .profile-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .profile-header p {
        margin: 0;
        opacity: .9;
    }

    .profile-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .05);
    }

    .section-title {
        font-size: 1.15rem;
        font-weight: 800;
        margin-bottom: 22px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 0;
        border-bottom: 1px solid #edf0f4;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .info-label {
        color: #8a929a;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: .4px;
    }

    .info-value {
        font-weight: 700;
        color: #343a40;
    }

    .subject-card {
        border: 1px solid #edf0f4;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 12px;
        transition: all .2s ease;
    }

        .subject-card:hover {
            border-color: #c9dcff;
            transform: translateY(-2px);
        }

    .subject-code {
        display: inline-block;
        background: #e7f1ff;
        color: #0d6efd;
        padding: 5px 9px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .subject-name {
        font-weight: 800;
        font-size: 1rem;
        margin-bottom: 4px;
    }

    .subject-hours {
        color: #6c757d;
        font-size: 13px;
    }

    .back-btn {
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {
        .profile-page {
            padding-top: 20px;
        }

        .profile-header {
            padding: 28px 22px;
        }

            .profile-header h1 {
                font-size: 1.8rem;
            }
    }
</style>

<div class="container profile-page">

    <div class="profile-header">

        <div class="profile-avatar">
            <i class="bi bi-person-workspace"></i>
        </div>

        <h1>
            @Model.FullName
        </h1>

        <p>
            Course Instructor
        </p>

    </div>

    <div class="row g-4">

        <div class="col-lg-5">

            <div class="profile-card">

                <div class="section-title">
                    <i class="bi bi-person-vcard me-2 text-primary"></i>
                    Teacher Information
                </div>

                <div class="info-row">

                    <div class="info-icon">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>

                        <div class="info-label">
                            Full Name
                        </div>

                        <div class="info-value">
                            @Model.FullName
                        </div>

                    </div>

                </div>

                <div class="info-row">

                    <div class="info-icon">
                        <i class="bi bi-at"></i>
                    </div>

                    <div>

                        <div class="info-label">
                            Username
                        </div>

                        <div class="info-value">
                            @Model.Username
                        </div>

                    </div>

                </div>

                <div class="info-row">

                    <div class="info-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <div>

                        <div class="info-label">
                            Email
                        </div>

                        <div class="info-value">
                            @Model.Email
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="profile-card">

                <div class="section-title">
                    <i class="bi bi-book me-2 text-primary"></i>
                    Your Subjects With @Model.FullName
                </div>

                @foreach (var subject in Model.Subjects)
                {
                    <div class="subject-card">

                        <div class="subject-code">
                            @subject.Code
                        </div>

                        <div class="subject-name">
                            @subject.Name
                        </div>

                        <div class="subject-hours">

                            <i class="bi bi-clock me-1"></i>

                            @subject.CreditHours
                            credit hour@(subject.CreditHours == 1 ? "" : "s")

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="text-center mt-4">

        <a asp-controller="Student"
           asp-action="Teachers"
           class="btn btn-outline-secondary back-btn">

            <i class="bi bi-arrow-left me-2"></i>

            Back to My Teachers

        </a>

    </div>

</div>