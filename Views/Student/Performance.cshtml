@model IEnumerable<StudentGradeApp.ViewModels.StudentPerformanceViewModel>

@{
    ViewData["Title"] = "My Performance";

    var performance = Model.ToList();

    decimal overallGpa = ViewBag.OverallGPA ?? 0m;
    string overallLetterGrade = ViewBag.OverallLetterGrade ?? "F";

    var totalCredits = performance.Sum(x => x.CreditHours);
}

<div class="container performance-page">

    <div class="performance-hero">

        <div class="hero-content">

            <div class="hero-icon">
                <i class="bi bi-bar-chart-fill"></i>
            </div>

            <div>
                <h1>My Performance</h1>
                <p>
                    Your overall academic performance and GPA.
                </p>
            </div>

        </div>

    </div>

    <div class="overall-card">

        <div class="overall-label">
            <i class="bi bi-trophy-fill"></i>
            Overall GPA
        </div>

        <div class="overall-content">

            <div class="overall-gpa">
                @overallGpa.ToString("0.00")
            </div>

            <div class="overall-divider"></div>

            <div class="overall-grade">

                <span>Overall Grade</span>

                <strong>
                    @overallLetterGrade
                </strong>

            </div>

        </div>

        <div class="overall-footer">

            <span>
                <i class="bi bi-book me-1"></i>
                @performance.Count Subjects
            </span>

            <span>
                <i class="bi bi-clock me-1"></i>
                @totalCredits Credit Hours
            </span>

        </div>

    </div>

    @if (!performance.Any())
    {
        <div class="empty-card">

            <div class="empty-icon">
                <i class="bi bi-bar-chart"></i>
            </div>

            <h3>No Performance Data</h3>

            <p>
                Your performance will appear here once you have
                grades for your subjects.
            </p>

        </div>
    }
    else
    {
        <div class="section-heading">

            <div>
                <h2>Subject Performance</h2>

                <p>
                    Your overall results for each subject.
                </p>
            </div>

        </div>

        <div class="performance-list">

            @foreach (var subject in performance)
            {
                <div class="performance-card">

                    <div class="subject-icon">
                        <i class="bi bi-book-fill"></i>
                    </div>

                    <div class="subject-info">

                        <h3>
                            @subject.SubjectName
                        </h3>

                        <span>
                            @subject.SubjectCode
                            ·
                            @subject.CreditHours Credit Hours
                        </span>

                    </div>

                    <div class="subject-result">

                        <div class="percentage">
                            @subject.Percentage.ToString("0.##")%
                        </div>

                        <div class="letter">
                            @subject.LetterGrade
                        </div>

                    </div>

                    <div class="subject-gpa">

                        <span>GPA</span>

                        <strong>
                            @subject.GPA.ToString("0.0")
                        </strong>

                    </div>

                </div>
            }

        </div>
    }

    <div class="bottom-actions">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-light action-btn">

            <i class="bi bi-arrow-left me-2"></i>
            Dashboard

        </a>

        <a asp-controller="Student"
           asp-action="Grades"
           class="btn btn-primary action-btn">

            <i class="bi bi-journal-text me-2"></i>
            View My Grades

        </a>

    </div>

</div>

<style>

    .performance-page {
        padding: 35px 0 60px;
    }

    .performance-hero {
        background: linear-gradient(135deg, #0d6efd, #5b8def);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 25px;
        box-shadow: 0 15px 35px rgba(13,110,253,.18);
    }

    .hero-content {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .hero-icon {
        width: 65px;
        height: 65px;
        border-radius: 19px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
    }

    .performance-hero h1 {
        margin: 0 0 6px;
        font-size: 2rem;
        font-weight: 800;
    }

    .performance-hero p {
        margin: 0;
        opacity: .9;
    }

    .overall-card {
        background: white;
        border-radius: 22px;
        padding: 28px;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        margin-bottom: 35px;
    }

    .overall-label {
        color: #6c757d;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 15px;
    }

        .overall-label i {
            color: #0d6efd;
            margin-right: 5px;
        }

    .overall-content {
        display: flex;
        align-items: center;
    }

    .overall-gpa {
        font-size: 4rem;
        line-height: 1;
        font-weight: 900;
        color: #0d6efd;
    }

    .overall-divider {
        width: 1px;
        height: 65px;
        background: #e9ecef;
        margin: 0 30px;
    }

    .overall-grade {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .overall-grade span {
            color: #6c757d;
            font-size: 13px;
            font-weight: 600;
        }

        .overall-grade strong {
            font-size: 2rem;
            font-weight: 900;
            color: #212529;
        }

    .overall-footer {
        display: flex;
        gap: 20px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
    }

    .section-heading {
        margin-bottom: 18px;
    }

        .section-heading h2 {
            font-size: 1.4rem;
            font-weight: 800;
            margin: 0 0 5px;
        }

        .section-heading p {
            margin: 0;
            color: #6c757d;
        }

    .performance-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .performance-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 18px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 6px 20px rgba(0,0,0,.04);
        transition: all .2s ease;
    }

        .performance-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,.07);
        }

    .subject-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .subject-info {
        flex: 1;
    }

        .subject-info h3 {
            margin: 0 0 4px;
            font-size: 16px;
            font-weight: 800;
        }

        .subject-info span {
            color: #8a94a6;
            font-size: 12px;
        }

    .subject-result {
        text-align: right;
        min-width: 100px;
    }

    .percentage {
        font-size: 18px;
        font-weight: 800;
        color: #212529;
    }

    .letter {
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        margin-top: 2px;
    }

    .subject-gpa {
        min-width: 75px;
        padding-left: 20px;
        border-left: 1px solid #edf0f4;
        text-align: center;
    }

        .subject-gpa span {
            display: block;
            color: #8a94a6;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .subject-gpa strong {
            font-size: 18px;
            font-weight: 800;
            color: #212529;
        }

    .empty-card {
        background: white;
        border-radius: 22px;
        padding: 65px 25px;
        text-align: center;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        border-radius: 21px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 30px;
    }

    .empty-card h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-card p {
        color: #6c757d;
        margin: 0;
    }

    .bottom-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 25px;
    }

    .action-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .performance-page {
            padding: 20px 0 40px;
        }

        .performance-hero {
            padding: 25px 20px;
        }

        .hero-icon {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }

        .performance-hero h1 {
            font-size: 1.6rem;
        }

        .overall-card {
            padding: 22px;
        }

        .overall-gpa {
            font-size: 3.2rem;
        }

        .overall-divider {
            margin: 0 20px;
        }

        .overall-footer {
            flex-direction: column;
            gap: 8px;
        }

        .performance-card {
            padding: 17px;
            gap: 12px;
        }

        .subject-info h3 {
            font-size: 14px;
        }

        .subject-info span {
            font-size: 11px;
        }

        .subject-result {
            min-width: 75px;
        }

        .subject-gpa {
            min-width: 55px;
            padding-left: 10px;
        }

        .bottom-actions {
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            width: 100%;
        }
    }

</style>