@model IEnumerable<StudentGradeApp.Models.StudentGrade>

@using StudentGradeApp.Models

@{
    ViewData["Title"] = "My Grades";

    var subjects = ViewBag.Subjects as List<Subject>
        ?? new List<Subject>();

    var selectedSubjectId = ViewBag.SelectedSubjectId as int?;

    var gradedComponentIds = ViewBag.GradedComponentIds as HashSet<int>
        ?? new HashSet<int>();

    var gradedComponents = ViewBag.GradedComponents is int
        ? (int)ViewBag.GradedComponents
        : 0;

    var totalComponents = ViewBag.TotalComponents is int
        ? (int)ViewBag.TotalComponents
        : 0;

    var isComplete = ViewBag.IsComplete is bool
        ? (bool)ViewBag.IsComplete
        : false;

    var finalPercentage = ViewBag.FinalPercentage is decimal
        ? (decimal)ViewBag.FinalPercentage
        : 0m;

    var finalLetterGrade = ViewBag.FinalLetterGrade as string ?? "Pending";

    var finalGpa = ViewBag.FinalGPA as decimal?;
}

<div class="container student-grades-page">

    <div class="grades-hero">

        <div class="hero-icon">
            <i class="bi bi-journal-text"></i>
        </div>

        <div>
            <h1>My Grades</h1>
            <p>
                Select a subject to view your individual grades.
            </p>
        </div>

    </div>

    <div class="subject-selector-card">

        <div class="selector-icon">
            <i class="bi bi-book"></i>
        </div>

        <div class="selector-content">

            <label class="form-label">
                Select Subject
            </label>

            <select class="form-select"
                    onchange="selectSubject(this.value)">

                <option value="">
                    Choose a subject...
                </option>

                @foreach (var subject in subjects)
                {
                    <option value="@subject.Id"
                            selected="@(selectedSubjectId == subject.Id)">
                        @subject.Code - @subject.Name
                    </option>
                }

            </select>

        </div>

    </div>

    @if (!selectedSubjectId.HasValue)
    {
        <div class="empty-card">

            <div class="empty-icon">
                <i class="bi bi-clipboard-data"></i>
            </div>

            <h3>Select a Subject</h3>

            <p>
                Choose a subject above to see your quizzes,
                assignments, exams and other grades.
            </p>

        </div>
    }
    else if (!Model.Any())
    {
        <div class="empty-card">

            <div class="empty-icon">
                <i class="bi bi-clipboard-x"></i>
            </div>

            <h3>No Grade Components</h3>

            <p>
                There are currently no grade components available
                for this subject.
            </p>

        </div>
    }
    else
    {
        var selectedSubject = subjects
            .FirstOrDefault(s => s.Id == selectedSubjectId.Value);

        <div class="grades-card">

            <div class="grades-card-header">

                <div>
                    <h2>
                        @(selectedSubject?.Name ?? "Subject")
                    </h2>

                    <p>
                        @(selectedSubject?.Code ?? "")
                    </p>
                </div>

                <div class="grade-count">
                    <i class="bi bi-list-check"></i>

                    @gradedComponents / @totalComponents
                    Graded
                </div>

            </div>

            @if (!isComplete)
            {
                <div class="pending-banner">

                    <div class="pending-banner-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div>
                        <strong>Final Grade Pending</strong>

                        <p>
                            Your final grade will become available once
                            all grade components have been completed.
                        </p>
                    </div>

                </div>
            }

            <div class="grade-list">

                @foreach (var grade in Model)
                {
                    var component = grade.GradeComponent;

                    if (component == null)
                    {
                        continue;
                    }

                    var hasGrade =
                        gradedComponentIds.Contains(component.Id);

                    <div class="grade-row">

                        @if (hasGrade)
                        {
                            <div class="component-icon-small">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                        }
                        else
                        {
                            <div class="component-icon-small not-graded-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        }

                        <div class="component-info">

                            <h4>
                                @component.Name
                            </h4>

                            <span>
                                @component.WeightPercentage% of final grade
                            </span>

                        </div>

                        @if (hasGrade)
                        {
                            var percentage = component.MaxGrade > 0
                                ? (grade.Grade / component.MaxGrade) * 100
                                : 0;

                            <div class="grade-result">

                                <strong>
                                    @grade.Grade.ToString("0.##")
                                </strong>

                                <span>
                                    / @component.MaxGrade.ToString("0.##")
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="not-graded-result">

                                <strong>
                                    Not Graded
                                </strong>

                                <span>
                                    / @component.MaxGrade.ToString("0.##")
                                </span>

                            </div>
                        }

                    </div>
                }

            </div>

            @if (isComplete)
            {
                <div class="final-grade-card">

                    <div class="final-grade-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>

                    <div class="final-grade-info">

                        <span>
                            Final Grade
                        </span>

                        <strong>
                            @finalPercentage.ToString("0.##")%
                        </strong>

                    </div>

                    <div class="final-letter">

                        <span>
                            Letter
                        </span>

                        <strong>
                            @finalLetterGrade
                        </strong>

                    </div>

                    <div class="final-gpa">

                        <span>
                            GPA
                        </span>

                        <strong>
                            @(finalGpa?.ToString("0.0") ?? "N/A")
                        </strong>

                    </div>

                </div>
            }
            else
            {
                <div class="final-grade-pending">

                    <div class="final-pending-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div>

                        <strong>
                            Final Grade Locked
                        </strong>

                        <p>
                            @gradedComponents of @totalComponents
                            grade components have been completed.
                            Your final grade will appear here when all
                            components have been graded.
                        </p>

                    </div>

                </div>
            }

        </div>
    }

    <div class="bottom-actions">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-light action-btn">

            <i class="bi bi-arrow-left me-2"></i>
            Dashboard

        </a>

        <a asp-controller="Student"
           asp-action="Performance"
           class="btn btn-primary action-btn">

            <i class="bi bi-bar-chart-fill me-2"></i>
            View Performance

        </a>

    </div>

</div>

<script>

    function selectSubject(subjectId) {

        if (!subjectId) {
            window.location.href =
                '@Url.Action("Grades", "Student")';

            return;
        }

        window.location.href =
            '@Url.Action("Grades", "Student")'
            + '?subjectId='
            + encodeURIComponent(subjectId);
    }

</script>

<style>

    .student-grades-page {
        padding: 35px 0 60px;
    }

    .grades-hero {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 35px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0d6efd, #5b8def);
        color: white;
        box-shadow: 0 15px 35px rgba(13,110,253,.18);
        margin-bottom: 25px;
    }

    .hero-icon {
        width: 65px;
        height: 65px;
        border-radius: 19px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 29px;
    }

    .grades-hero h1 {
        margin: 0 0 6px;
        font-size: 2rem;
        font-weight: 800;
    }

    .grades-hero p {
        margin: 0;
        opacity: .9;
    }

    .subject-selector-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
        margin-bottom: 25px;
    }

    .selector-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .selector-content {
        flex: 1;
    }

        .selector-content .form-label {
            font-weight: 700;
            margin-bottom: 7px;
        }

    .form-select {
        min-height: 48px;
        border-radius: 12px;
    }

        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.12);
        }

    .empty-card {
        text-align: center;
        background: white;
        padding: 65px 25px;
        border-radius: 22px;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        border-radius: 21px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .empty-card h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-card p {
        color: #6c757d;
        margin: 0;
    }

    .grades-card {
        background: white;
        border-radius: 22px;
        border: 1px solid #edf0f4;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .grades-card-header {
        padding: 25px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #edf0f4;
    }

        .grades-card-header h2 {
            margin: 0 0 4px;
            font-size: 1.35rem;
            font-weight: 800;
        }

        .grades-card-header p {
            margin: 0;
            color: #6c757d;
            font-size: 13px;
        }

    .grade-count {
        background: #eaf2ff;
        color: #0d6efd;
        padding: 9px 13px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
    }

    .pending-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 20px 28px 10px;
        padding: 16px 18px;
        background: #fff8eb;
        border: 1px solid #ffe4ad;
        border-radius: 14px;
    }

    .pending-banner-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #fff0d2;
        color: #f59f00;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pending-banner strong {
        display: block;
        color: #9a6500;
        font-size: 14px;
    }

    .pending-banner p {
        margin: 3px 0 0;
        color: #856f47;
        font-size: 12px;
    }

    .grade-list {
        padding: 5px 0;
    }

    .grade-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 28px;
        border-bottom: 1px solid #f0f1f3;
        transition: background .2s ease;
    }

        .grade-row:last-child {
            border-bottom: none;
        }

        .grade-row:hover {
            background: #fafcff;
        }

    .component-icon-small {
        width: 45px;
        height: 45px;
        border-radius: 13px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .not-graded-icon {
        background: #fff4e5;
        color: #f59f00;
    }

    .component-info {
        flex: 1;
    }

        .component-info h4 {
            margin: 0 0 4px;
            font-size: 15px;
            font-weight: 700;
        }

        .component-info span {
            color: #8a94a6;
            font-size: 12px;
        }

    .grade-result {
        min-width: 120px;
        text-align: right;
    }

        .grade-result strong {
            font-size: 20px;
            font-weight: 800;
            color: #212529;
        }

        .grade-result span {
            color: #6c757d;
            font-size: 14px;
        }

    .not-graded-result {
        min-width: 120px;
        text-align: right;
    }

        .not-graded-result strong {
            display: block;
            color: #f59f00;
            font-size: 14px;
            font-weight: 800;
        }

        .not-graded-result span {
            color: #adb5bd;
            font-size: 12px;
        }

    .final-grade-card {
        display: flex;
        align-items: center;
        gap: 20px;
        margin: 20px 28px 28px;
        padding: 22px;
        background: #f4f8ff;
        border: 1px solid #dce9ff;
        border-radius: 17px;
    }

    .final-grade-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .final-grade-info {
        flex: 1;
    }

        .final-grade-info span,
        .final-letter span,
        .final-gpa span {
            display: block;
            color: #6c757d;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .final-grade-info strong {
            font-size: 25px;
            font-weight: 900;
            color: #0d6efd;
        }

    .final-letter,
    .final-gpa {
        text-align: center;
        min-width: 75px;
        padding-left: 20px;
        border-left: 1px solid #dce5f2;
    }

        .final-letter strong,
        .final-gpa strong {
            font-size: 20px;
            font-weight: 900;
            color: #212529;
        }

    .final-grade-pending {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 20px 28px 28px;
        padding: 20px;
        background: #fff8eb;
        border: 1px solid #ffe4ad;
        border-radius: 17px;
    }

    .final-pending-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #fff0d2;
        color: #f59f00;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .final-grade-pending strong {
        color: #9a6500;
        font-size: 16px;
    }

    .final-grade-pending p {
        margin: 4px 0 0;
        color: #856f47;
        font-size: 13px;
    }

    .bottom-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 25px;
    }

    .action-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .student-grades-page {
            padding: 20px 0 40px;
        }

        .grades-hero {
            padding: 25px 20px;
        }

        .hero-icon {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }

        .grades-hero h1 {
            font-size: 1.6rem;
        }

        .subject-selector-card {
            align-items: flex-start;
        }

        .grades-card-header {
            padding: 20px;
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .pending-banner {
            margin-left: 18px;
            margin-right: 18px;
        }

        .grade-row {
            padding: 17px 18px;
            gap: 12px;
        }

        .grade-result,
        .not-graded-result {
            min-width: 90px;
        }

            .grade-result strong {
                font-size: 17px;
            }

        .component-info span {
            display: none;
        }

        .final-grade-card {
            margin: 18px;
            padding: 18px;
            gap: 12px;
        }

        .final-grade-info strong {
            font-size: 21px;
        }

        .final-grade-pending {
            margin: 18px;
        }

        .bottom-actions {
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            width: 100%;
        }
    }

</style>