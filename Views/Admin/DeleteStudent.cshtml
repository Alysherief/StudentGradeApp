@model StudentGradeApp.Models.AppUser

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body p-4 text-center">

                    <h2 class="text-danger mb-4">
                        Delete Student
                    </h2>

                    <p>
                        Are you sure you want to delete this student?
                    </p>

                    <div class="mb-4">
                        <strong>@Model.FullName</strong>
                        <br />
                        @Model.Email
                    </div>

                    <form asp-controller="Admin"
                          asp-action="DeleteStudentConfirmed"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete
                        </button>

                        <a asp-controller="Admin"
                           asp-action="ManageStudents"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>