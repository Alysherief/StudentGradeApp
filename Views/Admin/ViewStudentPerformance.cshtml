@model IEnumerable<StudentGradeApp.ViewModels.StudentPerformanceViewModel>

@{
    ViewData["Title"] = "Student Performance";

    var student = ViewBag.Student as StudentGradeApp.Models.AppUser;

    decimal overallGpa = ViewBag.OverallGPA ?? 0m;
    string overallLetterGrade = ViewBag.OverallLetterGrade ?? "N/A";

    var completedSubjects = Model.Count(x => x.IsComplete);
    var totalSubjects = Model.Count();

    var totalCreditHours = Model.Sum(x => x.CreditHours);

    var averagePercentage = Model.Any()
        ? Model.Average(x => x.IsComplete ? x.Percentage : 0)
        : 0;
}

<style>
    .performance-page {
        padding: 35px 0 60px;
    }

    .performance-header {
        background: linear-gradient(145deg, #0d6efd, #4f8dfd);
        border-radius: 24px;
        padding: 35px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(13, 110, 253, 0.18);
        margin-bottom: 25px;
    }

    .performance-header::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        right: -100px;
        top: -140px;
    }

    .performance-header::after {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        left: -100px;
        bottom: -140px;
    }

    .performance-header-content {
        position: relative;
        z-index: 2;
    }

    .student-profile {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .student-avatar {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        flex-shrink: 0;
    }

    .student-profile h1 {
        font-size: 2rem;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .student-email {
        opacity: 0.85;
        font-size: 14px;
    }

    .student-id {
        margin-top: 5px;
        font-size: 13px;
        opacity: 0.75;
    }

    .back-button {
        position: relative;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .back-button:hover {
        background: rgba(255, 255, 255, 0.22);
        color: white;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef5ff;
        color: #0d6efd;
        font-size: 21px;
        flex-shrink: 0;
    }

    .stat-value {
        font-size: 1.45rem;
        font-weight: 800;
        color: #1f2937;
        line-height: 1.2;
    }

    .stat-label {
        color: #8a94a6;
        font-size: 13px;
        margin-top: 3px;
    }

    .content-card {
        background: white;
        border-radius: 22px;
        border: none;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .content-card-header {
        padding: 24px 28px;
        border-bottom: 1px solid #eef0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .content-card-header h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        color: #1f2937;
    }

    .content-card-header p {
        margin: 4px 0 0;
        color: #8a94a6;
        font-size: 13px;
    }

    .subject-list {
        padding: 8px 20px 20px;
    }

    .subject-row {
        display: grid;
        grid-template-columns: 2.2fr 1fr 1fr 1fr 1fr;
        align-items: center;
        gap: 20px;
        padding: 20px 10px;
        border-bottom: 1px solid #f0f2f5;
    }

    .subject-row:last-child {
        border-bottom: none;
    }

    .subject-name {
        font-weight: 750;
        color: #1f2937;
        font-size: 15px;
    }

    .subject-code {
        color: #8a94a6;
        font-size: 12px;
        margin-top: 4px;
    }

    .column-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #9aa3b2;
        margin-bottom: 5px;
    }

    .column-value {
        font-weight: 700;
        color: #374151;
        font-size: 14px;
    }

    .grade-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        padding: 6px 10px;
        border-radius: 9px;
        font-weight: 800;
        font-size: 13px;
        background: #eef5ff;
        color: #0d6efd;
    }

    .pending-badge {
        background: #fff4e5;
        color: #d97706;
    }

    .gpa-value {
        font-weight: 800;
        color: #0d6efd;
    }

    .progress-wrapper {
        min-width: 120px;
    }

    .progress {
        height: 7px;
        border-radius: 20px;
        background: #edf0f4;
    }

    .progress-bar {
        border-radius: 20px;
    }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        color: #8a94a6;
    }

    .empty-state i {
        font-size: 45px;
        margin-bottom: 15px;
        color: #b7c0cc;
    }

    .empty-state h4 {
        color: #374151;
        font-weight: 750;
    }

    @@media (max-width: 991px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .subject-row {
            grid-template-columns: 2fr 1fr 1fr;
        }

        .subject-row > div:nth-child(4),
        .subject-row > div:nth-child(5) {
            display: none;
        }
    }

    @@media (max-width: 767px) {
        .performance-page {
            padding: 20px 12px 40px;
        }

        .performance-header {
            padding: 25px 20px;
        }

        .student-profile {
            align-items: flex-start;
        }

        .student-avatar {
            width: 60px;
            height: 60px;
            font-size: 25px;
        }

        .student-profile h1 {
            font-size: 1.5rem;
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .stat-card {
            padding: 16px;
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            font-size: 18px;
        }

        .stat-value {
            font-size: 1.15rem;
        }

        .subject-row {
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .subject-row > div:nth-child(3),
        .subject-row > div:nth-child(4),
        .subject-row > div:nth-child(5) {
            display: none;
        }
    }
</style>

<div class="performance-page">

    <div class="container">

        <div class="performance-header">

            <div class="performance-header-content">

                <div class="d-flex justify-content-between align-items-start gap-3">

                    <div class="student-profile">

                        <div class="student-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div>

                            <h1>
                                @(student?.FullName ?? "Student")
                            </h1>

                            <div class="student-email">
                                @(student?.Email ?? "No email available")
                            </div>

                            <div class="student-id">
                                Student ID: @(student?.Id ?? "N/A")
                            </div>

                        </div>

                    </div>

                    <a asp-action="ManageStudents"
                       class="back-button">

                        <i class="bi bi-arrow-left"></i>

                        Back to Students

                    </a>

                </div>

            </div>

        </div>


        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-award-fill"></i>
                </div>

                <div>

                    <div class="stat-value">
                        @overallGpa.ToString("0.00")
                    </div>

                    <div class="stat-label">
                        Overall GPA
                    </div>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>

                <div>

                    <div class="stat-value">
                        @overallLetterGrade
                    </div>

                    <div class="stat-label">
                        Overall Grade
                    </div>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-book-fill"></i>
                </div>

                <div>

                    <div class="stat-value">
                        @totalSubjects
                    </div>

                    <div class="stat-label">
                        Enrolled Subjects
                    </div>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>

                    <div class="stat-value">
                        @completedSubjects / @totalSubjects
                    </div>

                    <div class="stat-label">
                        Completed Subjects
                    </div>

                </div>

            </div>

        </div>


        <div class="content-card">

            <div class="content-card-header">

                <div>

                    <h3>
                        Academic Performance
                    </h3>

                    <p>
                        Subject grades and academic progress
                    </p>

                </div>

                <div class="text-muted small">
                    @totalCreditHours Credit Hours
                </div>

            </div>


            @if (!Model.Any())
            {
                <div class="empty-state">

                    <i class="bi bi-clipboard-x d-block"></i>

                    <h4>
                        No Performance Data
                    </h4>

                    <p>
                        This student does not have any approved subjects yet.
                    </p>

                </div>
            }
            else
            {
                <div class="subject-list">

                    <div class="subject-row d-none d-lg-grid"
                         style="border-bottom: 1px solid #e9ecef; padding-bottom: 12px;">

                        <div class="column-label">
                            Subject
                        </div>

                        <div class="column-label">
                            Progress
                        </div>

                        <div class="column-label">
                            Percentage
                        </div>

                        <div class="column-label">
                            Grade
                        </div>

                        <div class="column-label">
                            GPA
                        </div>

                    </div>


                    @foreach (var item in Model)
                    {
                        var percentage =
                            item.IsComplete
                                ? Math.Clamp(item.Percentage, 0, 100)
                                : 0;

                        <div class="subject-row">

                            <div>

                                <div class="subject-name">
                                    @item.SubjectName
                                </div>

                                <div class="subject-code">
                                    @item.SubjectCode
                                    ·
                                    @item.CreditHours credit hours
                                </div>

                            </div>


                            <div class="progress-wrapper">

                                <div class="d-flex justify-content-between mb-1">

                                    <span class="column-label mb-0">
                                        Progress
                                    </span>

                                    <span class="small text-muted">
                                        @item.GradedComponents/@item.TotalComponents
                                    </span>

                                </div>

                                <div class="progress">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @percentage%;">
                                    </div>

                                </div>

                            </div>


                            <div>

                                <div class="column-label">
                                    Percentage
                                </div>

                                <div class="column-value">

                                    @if (item.IsComplete)
                                    {
                                        @item.Percentage.ToString("0.00")
                                        <text>%</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Pending
                                        </span>
                                    }

                                </div>

                            </div>


                            <div>

                                <div class="column-label">
                                    Grade
                                </div>

                                @if (item.IsComplete)
                                {
                                    <span class="grade-badge">
                                        @item.LetterGrade
                                    </span>
                                }
                                else
                                {
                                    <span class="grade-badge pending-badge">
                                        Pending
                                    </span>
                                }

                            </div>


                            <div>

                                <div class="column-label">
                                    GPA
                                </div>

                                @if (item.IsComplete)
                                {
                                    <span class="gpa-value">
                                        @item.GPA.ToString("0.00")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>