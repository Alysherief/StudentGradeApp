@model IEnumerable<StudentGradeApp.Models.StudentSubject>

@{
    ViewData["Title"] = "Subject Requests";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>Subject Requests</h1>
        <p class="text-muted">
            Review student subject enrollment requests.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            There are no pending subject requests.
        </div>
    }
    else
    {
        <div class="card shadow">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Subject</th>
                                <th>Code</th>
                                <th>Credit Hours</th>
                                <th>Teacher</th>
                                <th>Requested</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var request in Model)
                            {
                                <tr>

                                    <td>
                                        @(request.Student?.FullName
                                            ?? request.Student?.UserName
                                            ?? "Unknown")
                                    </td>

                                    <td>
                                        @request.Subject?.Name
                                    </td>

                                    <td>
                                        @request.Subject?.Code
                                    </td>

                                    <td>
                                        @request.Subject?.CreditHours
                                    </td>

                                    <td>
                                        @(request.Subject?.Teacher?.FullName
                                            ?? "Not Assigned")
                                    </td>

                                    <td>
                                        @request.RequestedAt.ToLocalTime()
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <form asp-controller="Admin"
                                                  asp-action="ApproveSubject"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@request.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Approve
                                                </button>

                                            </form>

                                            <form asp-controller="Admin"
                                                  asp-action="RejectSubject"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@request.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Reject
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="text-center mt-4">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>