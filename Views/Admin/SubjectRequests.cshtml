@model IEnumerable<StudentGradeApp.Models.StudentSubject>

@using StudentGradeApp.Models

@{
    ViewData["Title"] = "Subject Requests";

    var requests = Model.ToList();

    var removalRequests =
        ViewBag.RemovalRequests as List<SubjectRemovalRequest>
        ?? new List<SubjectRemovalRequest>();

    var subjects = requests
        .Where(r => r.Subject != null)
        .Select(r => new
        {
            Id = r.SubjectId,
            Name = r.Subject!.Name,
            Code = r.Subject.Code
        })
        .Concat(
            removalRequests
                .Where(r => r.Subject != null)
                .Select(r => new
                {
                    Id = r.SubjectId,
                    Name = r.Subject!.Name,
                    Code = r.Subject.Code
                })
        )
        .GroupBy(x => x.Id)
        .Select(g => g.First())
        .OrderBy(x => x.Name)
        .ToList();

    var students = requests
        .Where(r => r.Student != null)
        .Select(r => new
        {
            Id = r.StudentId,
            Name = string.IsNullOrEmpty(r.Student!.FullName)
                ? r.Student.UserName
                : r.Student.FullName
        })
        .Concat(
            removalRequests
                .Where(r => r.Student != null)
                .Select(r => new
                {
                    Id = r.StudentId,
                    Name = string.IsNullOrEmpty(r.Student!.FullName)
                        ? r.Student.UserName
                        : r.Student.FullName
                })
        )
        .GroupBy(x => x.Id)
        .Select(g => g.First())
        .OrderBy(x => x.Name)
        .ToList();

    var totalRequests =
        requests.Count +
        removalRequests.Count;
}

<style>

    .requests-page {
        padding: 35px 0 60px;
    }

    .requests-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 24px;
        padding: 38px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(13, 110, 253, 0.18);
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .requests-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .requests-header p {
        margin: 0;
        opacity: 0.9;
    }

    .filter-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .filter-title {
        font-weight: 800;
        font-size: 1.1rem;
        margin-bottom: 20px;
    }

    .filter-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #6c757d;
        margin-bottom: 7px;
    }

    .filter-select {
        width: 100%;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 11px 14px;
        font-size: 14px;
        background-color: white;
        outline: none;
        transition: all .2s ease;
    }

        .filter-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
        }

    .clear-btn {
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 700;
    }

    .result-count {
        margin-top: 15px;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
    }

    .requests-table-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

        .requests-table-card .card-body {
            padding: 25px;
        }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            color: #495057;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
            border-bottom-width: 1px;
        }

        .table tbody td {
            font-size: 14px;
        }

    .student-name {
        font-weight: 700;
        color: #212529;
    }

    .subject-name {
        font-weight: 700;
        color: #212529;
    }

    .subject-code {
        display: inline-block;
        background: #eaf2ff;
        color: #0d6efd;
        padding: 5px 9px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .credit-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f1f3f5;
        color: #495057;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .teacher-name {
        font-weight: 600;
        color: #495057;
    }

    .requested-date {
        color: #6c757d;
        white-space: nowrap;
        font-size: 13px;
    }

    .request-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .enrollment-badge {
        background: #d1e7dd;
        color: #146c43;
    }

    .removal-badge {
        background: #f8d7da;
        color: #b02a37;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            border-radius: 9px;
            font-weight: 600;
        }

    .no-results {
        display: none;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        padding: 50px 30px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .no-results-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 18px;
    }

    .no-results h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .no-results p {
        color: #6c757d;
        margin-bottom: 20px;
    }

    .empty-state {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 22px;
        padding: 60px 30px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .05);
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 22px;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
        margin: 0 auto 20px;
    }

    .empty-state h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #6c757d;
        max-width: 500px;
        margin: 0 auto 25px;
    }

    .main-btn {
        border-radius: 12px;
        padding: 11px 20px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .requests-page {
            padding-top: 20px;
        }

        .requests-header {
            padding: 28px 22px;
            border-radius: 20px;
        }

            .requests-header h1 {
                font-size: 1.8rem;
            }

        .filter-card {
            padding: 20px;
        }

        .requests-table-card .card-body {
            padding: 15px;
        }
    }

</style>

<div class="container requests-page">

    <div class="requests-header">

        <div class="header-icon">
            <i class="bi bi-clipboard-check-fill"></i>
        </div>

        <h1>
            Subject Requests
        </h1>

        <p>
            Review and manage student subject enrollment and removal requests.
        </p>

    </div>

    @if (totalRequests == 0)
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="bi bi-inbox-fill"></i>
            </div>

            <h3>
                No Pending Requests
            </h3>

            <p>
                There are currently no pending subject enrollment or removal requests waiting for administrator approval.
            </p>

        </div>
    }
    else
    {
        <div class="filter-card">

            <div class="filter-title">
                <i class="bi bi-funnel-fill me-2 text-primary"></i>
                Filter Requests
            </div>

            <div class="row g-3 align-items-end">

                <div class="col-md-3">

                    <label for="requestTypeFilter"
                           class="filter-label">

                        Request Type

                    </label>

                    <select id="requestTypeFilter"
                            class="filter-select">

                        <option value="">
                            All Requests
                        </option>

                        <option value="enrollment">
                            Subject Enrollment
                        </option>

                        <option value="removal">
                            Subject Removal
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label for="subjectFilter"
                           class="filter-label">

                        Subject

                    </label>

                    <select id="subjectFilter"
                            class="filter-select">

                        <option value="">
                            All Subjects
                        </option>

                        @foreach (var subject in subjects)
                        {
                            <option value="@subject.Id">
                                @subject.Code - @subject.Name
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label for="studentFilter"
                           class="filter-label">

                        Student

                    </label>

                    <select id="studentFilter"
                            class="filter-select">

                        <option value="">
                            All Students
                        </option>

                        @foreach (var student in students)
                        {
                            <option value="@student.Id">
                                @student.Name
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <button type="button"
                            id="clearFilters"
                            class="btn btn-outline-secondary clear-btn w-100">

                        <i class="bi bi-x-circle me-1"></i>
                        Clear

                    </button>

                </div>

            </div>

            <div id="resultCount"
                 class="result-count">

                Showing @totalRequests requests

            </div>

        </div>

        <div id="requestsTable"
             class="requests-table-card">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Request Type
                                </th>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Subject
                                </th>

                                <th>
                                    Code
                                </th>

                                <th>
                                    Credit Hours
                                </th>

                                <th>
                                    Teacher
                                </th>

                                <th>
                                    Requested
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody id="requestsBody">

                            @foreach (var request in requests)
                            {
                                <tr class="request-row"
                                    data-request-type="enrollment"
                                    data-subject-id="@request.SubjectId"
                                    data-student-id="@request.StudentId">

                                    <td>

                                        <span class="request-type-badge enrollment-badge">

                                            <i class="bi bi-plus-circle-fill"></i>

                                            Enrollment

                                        </span>

                                    </td>

                                    <td>

                                        <span class="student-name">

                                            @(request.Student?.FullName
                                                ?? request.Student?.UserName
                                                ?? "Unknown")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="subject-name">

                                            @request.Subject?.Name

                                        </span>

                                    </td>

                                    <td>

                                        <span class="subject-code">

                                            @request.Subject?.Code

                                        </span>

                                    </td>

                                    <td>

                                        <span class="credit-badge">

                                            <i class="bi bi-clock"></i>

                                            @request.Subject?.CreditHours

                                            @(request.Subject?.CreditHours == 1
                                                ? "Credit"
                                                : "Credits")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="teacher-name">

                                            @(request.Subject?.Teacher?.FullName
                                                ?? "Not Assigned")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="requested-date">

                                            @request.RequestedAt.ToLocalTime()

                                        </span>

                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <form asp-controller="Admin"
                                                  asp-action="ApproveSubject"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@request.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">

                                                    <i class="bi bi-check-lg me-1"></i>

                                                    Approve

                                                </button>

                                            </form>

                                            <form asp-controller="Admin"
                                                  asp-action="RejectSubject"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@request.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">

                                                    <i class="bi bi-x-lg me-1"></i>

                                                    Reject

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                            @foreach (var request in removalRequests)
                            {
                                <tr class="request-row"
                                    data-request-type="removal"
                                    data-subject-id="@request.SubjectId"
                                    data-student-id="@request.StudentId">

                                    <td>

                                        <span class="request-type-badge removal-badge">

                                            <i class="bi bi-dash-circle-fill"></i>

                                            Removal

                                        </span>

                                    </td>

                                    <td>

                                        <span class="student-name">

                                            @(request.Student?.FullName
                                                ?? request.Student?.UserName
                                                ?? "Unknown")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="subject-name">

                                            @request.Subject?.Name

                                        </span>

                                    </td>

                                    <td>

                                        <span class="subject-code">

                                            @request.Subject?.Code

                                        </span>

                                    </td>

                                    <td>

                                        <span class="credit-badge">

                                            <i class="bi bi-clock"></i>

                                            @request.Subject?.CreditHours

                                            @(request.Subject?.CreditHours == 1
                                                ? "Credit"
                                                : "Credits")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="teacher-name">

                                            @(request.Subject?.Teacher?.FullName
                                                ?? "Not Assigned")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="requested-date">

                                            @request.RequestedAt.ToLocalTime()

                                        </span>

                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <form asp-controller="Admin"
                                                  asp-action="ApproveRemoval"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@request.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">

                                                    <i class="bi bi-check-lg me-1"></i>

                                                    Approve

                                                </button>

                                            </form>

                                            <form asp-controller="Admin"
                                                  asp-action="RejectRemoval"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@request.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">

                                                    <i class="bi bi-x-lg me-1"></i>

                                                    Reject

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div id="noResults"
             class="no-results">

            <div class="no-results-icon">

                <i class="bi bi-search"></i>

            </div>

            <h3>
                No Requests Found
            </h3>

            <p>
                No requests match the selected filters.
            </p>

            <button type="button"
                    id="clearFiltersEmpty"
                    class="btn btn-primary main-btn">

                <i class="bi bi-arrow-counterclockwise me-2"></i>

                Clear Filters

            </button>

        </div>
    }

    <div class="text-center mt-4">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary main-btn">

            <i class="bi bi-speedometer2 me-2"></i>

            Back to Dashboard

        </a>

    </div>

</div>

@if (totalRequests > 0)
{
    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const requestTypeFilter =
                document.getElementById("requestTypeFilter");

            const subjectFilter =
                document.getElementById("subjectFilter");

            const studentFilter =
                document.getElementById("studentFilter");

            const clearFilters =
                document.getElementById("clearFilters");

            const clearFiltersEmpty =
                document.getElementById("clearFiltersEmpty");

            const rows =
                document.querySelectorAll(".request-row");

            const resultCount =
                document.getElementById("resultCount");

            const requestsTable =
                document.getElementById("requestsTable");

            const noResults =
                document.getElementById("noResults");


            function applyFilters() {

                const selectedType =
                    requestTypeFilter.value;

                const selectedSubject =
                    subjectFilter.value;

                const selectedStudent =
                    studentFilter.value;

                let visibleCount = 0;


                rows.forEach(function(row) {

                    const rowType =
                        row.dataset.requestType;

                    const rowSubject =
                        row.dataset.subjectId;

                    const rowStudent =
                        row.dataset.studentId;


                    const typeMatches =
                        selectedType === "" ||
                        rowType === selectedType;


                    const subjectMatches =
                        selectedSubject === "" ||
                        rowSubject === selectedSubject;


                    const studentMatches =
                        selectedStudent === "" ||
                        rowStudent === selectedStudent;


                    if (
                        typeMatches &&
                        subjectMatches &&
                        studentMatches
                    ) {

                        row.style.display = "";

                        visibleCount++;

                    }
                    else {

                        row.style.display = "none";

                    }

                });


                const totalCount =
                    rows.length;


                if (
                    selectedType === "" &&
                    selectedSubject === "" &&
                    selectedStudent === ""
                ) {

                    resultCount.textContent =
                        "Showing " +
                        totalCount +
                        " requests";

                }
                else {

                    resultCount.textContent =
                        "Showing " +
                        visibleCount +
                        " of " +
                        totalCount +
                        " requests";

                }


                if (visibleCount === 0) {

                    requestsTable.style.display = "none";

                    noResults.style.display = "block";

                }
                else {

                    requestsTable.style.display = "block";

                    noResults.style.display = "none";

                }

            }


            requestTypeFilter.addEventListener(
                "change",
                applyFilters
            );


            subjectFilter.addEventListener(
                "change",
                applyFilters
            );


            studentFilter.addEventListener(
                "change",
                applyFilters
            );


            function resetFilters() {

                requestTypeFilter.value = "";

                subjectFilter.value = "";

                studentFilter.value = "";

                applyFilters();

            }


            clearFilters.addEventListener(
                "click",
                resetFilters
            );


            clearFiltersEmpty.addEventListener(
                "click",
                resetFilters
            );


            applyFilters();

        });

    </script>
}