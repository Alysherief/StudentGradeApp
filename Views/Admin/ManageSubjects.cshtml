@model IEnumerable<StudentGradeApp.Models.Subject>

@{
    ViewData["Title"] = "Manage Subjects";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Manage Subjects</h2>

        <a asp-controller="Admin"
           asp-action="CreateSubject"
           class="btn btn-primary">
            Create Subject
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No subjects have been created yet.
        </div>
    }
    else
    {
        <div class="card shadow">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Credit Hours</th>
                                <th>Teacher</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var subject in Model)
                            {
                                <tr>

                                    <td>
                                        @subject.Name
                                    </td>

                                    <td>
                                        @subject.Code
                                    </td>

                                    <td>
                                        @subject.CreditHours
                                    </td>

                                    <td>
                                        @(subject.Teacher?.FullName ?? "Not Assigned")
                                    </td>

                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="EditSubject"
                                           asp-route-id="@subject.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="DeleteSubject"
                                           asp-route-id="@subject.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="mt-3">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>