@model IEnumerable<StudentGradeApp.Models.Subject>

@{
    ViewData["Title"] = "Manage Subjects";

    var subjects = Model.ToList();
}

<style>

    .subject-page {
        padding: 35px 0 60px;
    }

    .subject-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 24px;
        padding: 38px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(13, 110, 253, 0.18);
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .subject-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .subject-header p {
        margin: 0;
        opacity: 0.9;
    }

    .header-action {
        margin-top: 25px;
    }

    .main-btn {
        border-radius: 12px;
        padding: 11px 20px;
        font-weight: 700;
    }

    .summary-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .summary-title {
        font-weight: 800;
        font-size: 1.1rem;
        margin-bottom: 20px;
    }

    .summary-number {
        font-size: 2rem;
        font-weight: 800;
        color: #0d6efd;
    }

    .summary-label {
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-active {
        background: #d1e7dd;
        color: #146c43;
    }

    .status-empty {
        background: #fff3cd;
        color: #856404;
    }

    .search-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        padding: 20px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .search-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        z-index: 2;
    }

    .search-input {
        border-radius: 12px;
        padding: 12px 45px 12px 42px;
        border: 1px solid #dee2e6;
        font-weight: 500;
    }

        .search-input:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, .12);
        }

    .clear-search {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #6c757d;
        display: none;
        padding: 5px;
    }

        .clear-search:hover {
            color: #212529;
        }

    .search-result-count {
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        margin-top: 10px;
    }

    .no-search-results {
        display: none;
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 22px;
        padding: 50px 30px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .05);
    }

    .no-search-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 18px;
    }

    .subject-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 20px;
        height: 100%;
        overflow: hidden;
        box-shadow: 0 7px 22px rgba(0, 0, 0, .05);
        transition: all .25s ease;
    }

        .subject-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, .09);
            border-color: #c9dcff;
        }

    .subject-top {
        padding: 22px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border-bottom: 1px solid #e7edf7;
    }

    .subject-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .subject-body {
        padding: 22px;
    }

    .subject-name {
        font-size: 1.25rem;
        font-weight: 800;
        color: #212529;
        margin-bottom: 20px;
    }

    .subject-info {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .info-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #f1f5ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .info-text small {
        display: block;
        color: #8a929a;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: .3px;
    }

    .info-text span {
        font-weight: 700;
        color: #343a40;
        word-break: break-word;
    }

    .teacher-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e7f1ff;
        color: #0d6efd;
        padding: 7px 11px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
    }

    .no-teacher-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff3cd;
        color: #856404;
        padding: 7px 11px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
    }

    .card-actions {
        border-top: 1px solid #edf0f4;
        margin-top: 20px;
        padding-top: 18px;
        display: flex;
        gap: 8px;
    }

        .card-actions .btn {
            border-radius: 10px;
            font-weight: 600;
        }

    .empty-state {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 22px;
        padding: 60px 30px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .05);
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 22px;
        background: #eef4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
        margin: 0 auto 20px;
    }

    .empty-state h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #6c757d;
        max-width: 500px;
        margin: 0 auto 25px;
    }

    @@media (max-width: 767px) {

        .subject-page {
            padding-top: 20px;
        }

        .subject-header {
            padding: 28px 22px;
            border-radius: 20px;
        }

            .subject-header h1 {
                font-size: 1.8rem;
            }

        .subject-body,
        .subject-top {
            padding: 20px;
        }
    }

</style>

<div class="container subject-page">

    <div class="subject-header">

        <div class="header-icon">
            <i class="bi bi-book-half"></i>
        </div>

        <h1>
            Manage Subjects
        </h1>

        <p>
            Create, edit and manage university subjects and their assigned teachers.
        </p>

        <div class="header-action">

            <a asp-controller="Admin"
               asp-action="CreateSubject"
               class="btn btn-light main-btn">

                <i class="bi bi-plus-circle-fill me-2"></i>

                Create Subject

            </a>

        </div>

    </div>

    <div class="summary-card">

        <div class="summary-title">
            Subject Overview
        </div>

        <div class="row align-items-center">

            <div class="col-md-3">

                <div class="summary-label">
                    Total Subjects
                </div>

                <div class="summary-number">
                    @subjects.Count
                </div>

            </div>

            <div class="col-md-6 mt-3 mt-md-0">

                <div class="summary-label">
                    Available Subjects
                </div>

                <p class="text-muted mb-0 mt-1">
                    All subjects currently registered in the system.
                </p>

            </div>

            <div class="col-md-3 text-md-end mt-3 mt-md-0">

                @if (subjects.Any())
                {
                    <span class="status-badge status-active">

                        <i class="bi bi-check-circle-fill"></i>

                        Subjects Available

                    </span>
                }
                else
                {
                    <span class="status-badge status-empty">

                        <i class="bi bi-info-circle-fill"></i>

                        No Subjects

                    </span>
                }

            </div>

        </div>

    </div>

    @if (!subjects.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="bi bi-book-half"></i>
            </div>

            <h3>
                No Subjects Yet
            </h3>

            <p>
                No subjects have been created yet.
                Create the first subject to start managing your academic courses.
            </p>

            <a asp-controller="Admin"
               asp-action="CreateSubject"
               class="btn btn-primary main-btn">

                <i class="bi bi-plus-circle-fill me-2"></i>

                Create First Subject

            </a>

        </div>
    }
    else
    {
        <div class="search-card">

            <div class="search-wrapper">

                <i class="bi bi-search search-icon"></i>

                <input type="text"
                       id="subjectSearch"
                       class="form-control search-input"
                       placeholder="Search subjects by name, code or teacher..."
                       autocomplete="off" />

                <button type="button"
                        id="clearSubjectSearch"
                        class="clear-search">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <div id="subjectResultCount"
                 class="search-result-count">

                Showing @subjects.Count subject@(subjects.Count == 1 ? "" : "s")

            </div>

        </div>

        <div id="subjectsContainer" class="row g-4">

            @foreach (var subject in subjects)
            {
                <div class="col-md-6 col-lg-4 subject-search-item"
                     data-search="@($"{subject.Name} {subject.Code} {subject.Teacher?.FullName}")">

                    <div class="subject-card">

                        <div class="subject-top">

                            <div class="d-flex align-items-center gap-3">

                                <div class="subject-icon">
                                    <i class="bi bi-book-fill"></i>
                                </div>

                                <div>

                                    <div class="fw-bold">
                                        @subject.Name
                                    </div>

                                    <small class="text-muted">
                                        University Subject
                                    </small>

                                </div>

                            </div>

                        </div>

                        <div class="subject-body">

                            <div class="subject-name">
                                @subject.Name
                            </div>

                            <div class="subject-info">

                                <div class="info-icon">
                                    <i class="bi bi-hash"></i>
                                </div>

                                <div class="info-text">

                                    <small>
                                        Subject Code
                                    </small>

                                    <span>
                                        @subject.Code
                                    </span>

                                </div>

                            </div>

                            <div class="subject-info">

                                <div class="info-icon">
                                    <i class="bi bi-person-badge-fill"></i>
                                </div>

                                <div class="info-text">

                                    <small>
                                        Assigned Teacher
                                    </small>

                                    <span>
                                        @(subject.Teacher?.FullName ?? "No teacher assigned")
                                    </span>

                                </div>

                            </div>

                            <div class="mt-3">

                                @if (subject.Teacher != null)
                                {
                                    <span class="teacher-badge">

                                        <i class="bi bi-person-check-fill"></i>

                                        Teacher Assigned

                                    </span>
                                }
                                else
                                {
                                    <span class="no-teacher-badge">

                                        <i class="bi bi-person-x-fill"></i>

                                        No Teacher

                                    </span>
                                }

                            </div>

                            <div class="card-actions">

                                <a asp-controller="Admin"
                                   asp-action="EditSubject"
                                   asp-route-id="@subject.Id"
                                   class="btn btn-outline-primary btn-sm flex-grow-1">

                                    <i class="bi bi-pencil me-1"></i>

                                    Edit

                                </a>

                                <a asp-controller="Admin"
                                   asp-action="DeleteSubject"
                                   asp-route-id="@subject.Id"
                                   class="btn btn-outline-danger btn-sm flex-grow-1">

                                    <i class="bi bi-trash me-1"></i>

                                    Delete

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

        <div id="noSearchResults" class="no-search-results mt-4">

            <div class="no-search-icon">
                <i class="bi bi-search"></i>
            </div>

            <h3 class="fw-bold">
                No Subjects Found
            </h3>

            <p class="text-muted mb-0">
                Try searching with a different subject name, code or teacher.
            </p>

        </div>
    }

    <div class="text-center mt-5">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary main-btn">

            <i class="bi bi-speedometer2 me-2"></i>

            Back to Dashboard

        </a>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput =
                document.getElementById("subjectSearch");

            const clearButton =
                document.getElementById("clearSubjectSearch");

            const resultCount =
                document.getElementById("subjectResultCount");

            const noResults =
                document.getElementById("noSearchResults");

            const items =
                document.querySelectorAll(".subject-search-item");

            if (!searchInput) {
                return;
            }

            function searchSubjects() {

                const searchValue =
                    searchInput.value.trim().toLowerCase();

                let visibleCount = 0;

                items.forEach(function(item) {

                    const searchText =
                        item.dataset.search.toLowerCase();

                    const matches =
                        searchText.includes(searchValue);

                    item.style.display =
                        matches ? "" : "none";

                    if (matches) {
                        visibleCount++;
                    }

                });

                clearButton.style.display =
                    searchValue.length > 0 ? "block" : "none";

                resultCount.textContent =
                    "Showing " +
                    visibleCount +
                    " subject" +
                    (visibleCount === 1 ? "" : "s");

                noResults.style.display =
                    visibleCount === 0 ? "block" : "none";
            }

            searchInput.addEventListener(
                "input",
                searchSubjects
            );

            clearButton.addEventListener(
                "click",
                function() {

                    searchInput.value = "";

                    searchInput.focus();

                    searchSubjects();

                }
            );

        });

    </script>

}