@model IEnumerable<StudentGradeApp.Models.AppUser>

@{
    ViewData["Title"] = "Manage Students";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Manage Students</h2>

        <a asp-controller="Admin"
           asp-action="CreateStudent"
           class="btn btn-primary">
            Create Student
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No students have been created yet.
        </div>
    }
    else
    {
        <div class="card shadow">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var student in Model)
                            {
                                <tr>

                                    <td>
                                        @student.FullName
                                    </td>

                                    <td>
                                        @student.UserName
                                    </td>

                                    <td>
                                        @student.Email
                                    </td>

                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="EditStudent"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="DeleteStudent"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="mt-3">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>