@model StudentGradeApp.ViewModels.EditTeacherViewModel

@{
    ViewData["Title"] = "Edit Teacher";
}

<style>

    .edit-teacher-page {
        padding: 35px 0 60px;
    }

    /* =========================
           HEADER
           ========================= */

    .edit-header {
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        border-radius: 24px;
        padding: 38px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(13, 110, 253, 0.18);
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .edit-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .edit-header p {
        margin: 0;
        opacity: 0.9;
    }


    /* =========================
           FORM CARD
           ========================= */

    .form-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 22px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .form-card-header {
        padding: 25px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border-bottom: 1px solid #e7edf7;
    }

    .form-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .form-card-header h4 {
        font-weight: 800;
        margin-bottom: 4px;
    }

    .form-card-body {
        padding: 30px;
    }


    /* =========================
           FORM ELEMENTS
           ========================= */

    .form-label {
        font-weight: 700;
        color: #343a40;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding: 12px 15px;
        transition: all .2s ease;
    }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .form-control-lg {
        min-height: 50px;
    }

    .input-section {
        margin-bottom: 22px;
    }


    /* =========================
           VALIDATION
           ========================= */

    .validation-summary {
        border-radius: 12px;
    }


    /* =========================
           ACTIONS
           ========================= */

    .form-actions {
        border-top: 1px solid #edf0f4;
        margin-top: 10px;
        padding-top: 22px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .main-btn {
        border-radius: 12px;
        padding: 11px 20px;
        font-weight: 700;
    }


    /* =========================
           BACK BUTTON
           ========================= */

    .back-button {
        margin-top: 35px;
    }


    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 767px) {

        .edit-teacher-page {
            padding-top: 20px;
        }

        .edit-header {
            padding: 28px 22px;
            border-radius: 20px;
        }

            .edit-header h1 {
                font-size: 1.8rem;
            }

        .form-card-header,
        .form-card-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

            .form-actions .btn {
                width: 100%;
            }
    }

</style>


<div class="container edit-teacher-page">

    <!-- =========================
         HEADER
         ========================= -->

    <div class="edit-header">

        <div class="header-icon">

            <i class="bi bi-person-gear-fill"></i>

        </div>

        <h1>
            Edit Teacher
        </h1>

        <p>
            Update the teacher's personal information and account details.
        </p>

    </div>


    <!-- =========================
         FORM
         ========================= -->

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="form-card">

                <!-- FORM HEADER -->

                <div class="form-card-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="form-card-icon">

                            <i class="bi bi-person-vcard-fill"></i>

                        </div>

                        <div>

                            <h4>
                                Teacher Information
                            </h4>

                            <p class="text-muted mb-0">
                                Modify the teacher's account information below.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- FORM BODY -->

                <div class="form-card-body">

                    <form asp-controller="Admin"
                          asp-action="EditTeacher"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />


                        <!-- VALIDATION -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger validation-summary"
                             role="alert">
                        </div>


                        <!-- FULL NAME -->

                        <div class="input-section">

                            <label asp-for="FullName"
                                   class="form-label">

                                <i class="bi bi-person-fill text-primary me-1"></i>

                                Full Name

                            </label>

                            <input asp-for="FullName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter teacher's full name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- USERNAME + EMAIL -->

                        <div class="row">

                            <div class="col-md-6">

                                <div class="input-section">

                                    <label asp-for="Username"
                                           class="form-label">

                                        <i class="bi bi-at text-primary me-1"></i>

                                        Username

                                    </label>

                                    <input asp-for="Username"
                                           class="form-control form-control-lg"
                                           autocomplete="username"
                                           placeholder="Enter username" />

                                    <span asp-validation-for="Username"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-section">

                                    <label asp-for="Email"
                                           class="form-label">

                                        <i class="bi bi-envelope-fill text-primary me-1"></i>

                                        Email Address

                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control form-control-lg"
                                           autocomplete="email"
                                           placeholder="teacher@example.com" />

                                    <span asp-validation-for="Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="form-actions">

                            <a asp-controller="Admin"
                               asp-action="ManageTeachers"
                               class="btn btn-light btn-lg main-btn">

                                <i class="bi bi-x-lg me-2"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-primary btn-lg main-btn">

                                <i class="bi bi-check-lg me-2"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         BACK TO DASHBOARD
         ========================= -->

    <div class="text-center back-button">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary main-btn">

            <i class="bi bi-speedometer2 me-2"></i>

            Back to Dashboard

        </a>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}