@model StudentGradeApp.Models.GradeComponent

@{
    ViewData["Title"] = "Edit Grade Component";

    var subject = ViewBag.Subject as StudentGradeApp.Models.Subject;
}

<style>

    .grade-edit-page {
        padding: 35px 0 60px;
    }

    .edit-header {
        background: linear-gradient(135deg, #6f42c1, #8e63d2);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(111, 66, 193, 0.18);
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .edit-header h1 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .edit-header p {
        margin: 0;
        opacity: .9;
    }

    .form-card {
        background: white;
        border: 1px solid #edf0f4;
        border-radius: 22px;
        padding: 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
    }

    .subject-info {
        background: #f8f5ff;
        border: 1px solid #e8ddff;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 28px;
    }

    .subject-code {
        display: inline-block;
        background: #6f42c1;
        color: white;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .subject-name {
        font-size: 1.2rem;
        font-weight: 800;
    }

    .form-label {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px 14px;
    }

        .form-control:focus {
            border-color: #6f42c1;
            box-shadow: 0 0 0 .2rem rgba(111,66,193,.12);
        }

    .field-help {
        color: #6c757d;
        font-size: 13px;
        margin-top: 6px;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 14px;
        padding: 18px;
        margin-top: 25px;
    }

    .info-box-title {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .info-box p {
        margin: 0;
        color: #6c757d;
        font-size: 14px;
    }

    .action-buttons {
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #edf0f4;
        display: flex;
        gap: 10px;
    }

        .action-buttons .btn {
            border-radius: 11px;
            padding: 11px 20px;
            font-weight: 700;
        }

    @@media (max-width: 767px) {

        .grade-edit-page {
            padding-top: 20px;
        }

        .edit-header {
            padding: 28px 22px;
            border-radius: 20px;
        }

        .form-card {
            padding: 22px;
        }

        .action-buttons {
            flex-direction: column;
        }

            .action-buttons .btn {
                width: 100%;
            }
    }

</style>


<div class="container grade-edit-page">

    <!-- HEADER -->

    <div class="edit-header">

        <div class="header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>

        <h1>
            Edit Grade Component
        </h1>

        <p>
            Update the grading details for this component.
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="form-card">

                <!-- SUBJECT INFORMATION -->
                @if (subject != null)
                {
                    <div class="subject-info">

                        <span class="subject-code">
                            @subject.Code
                        </span>

                        <div class="subject-name">
                            @subject.Name
                        </div>

                        @if (!string.IsNullOrWhiteSpace(subject.Description))
                        {
                            <div class="text-muted mt-1">
                                @subject.Description
                            </div>
                        }

                    </div>
                }


                <form asp-controller="Admin"
                      asp-action="EditGradeComponent"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Id" />

                    <input type="hidden"
                           asp-for="SubjectId" />


                    <!-- VALIDATION -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <!-- NAME -->

                    <div class="mb-4">

                        <label asp-for="Name"
                               class="form-label">
                            Component Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Quiz 1, Midterm, Final Exam" />

                        <div class="field-help">
                            Give the grading component a clear name.
                        </div>

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- MAXIMUM GRADE -->

                    <div class="mb-4">

                        <label asp-for="MaxGrade"
                               class="form-label">
                            Maximum Grade
                        </label>

                        <div class="input-group">

                            <input asp-for="MaxGrade"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   step="0.01"
                                   placeholder="e.g. 20" />

                            <span class="input-group-text">
                                Marks
                            </span>

                        </div>

                        <div class="field-help">
                            The highest possible mark for this component.
                        </div>

                        <span asp-validation-for="MaxGrade"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- WEIGHT -->

                    <div class="mb-4">

                        <label asp-for="WeightPercentage"
                               class="form-label">
                            Weight Percentage
                        </label>

                        <div class="input-group">

                            <input asp-for="WeightPercentage"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   placeholder="e.g. 10" />

                            <span class="input-group-text">
                                %
                            </span>

                        </div>

                        <div class="field-help">
                            How much this component contributes to the final subject grade.
                        </div>

                        <span asp-validation-for="WeightPercentage"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- INFORMATION -->

                    <div class="info-box">

                        <div class="info-box-title">

                            <i class="bi bi-info-circle-fill text-primary me-2"></i>

                            Grade Distribution

                        </div>

                        <p>
                            Make sure the total weight of all components
                            for this subject does not exceed
                            <strong>100%</strong>.
                        </p>

                    </div>


                    <!-- ACTIONS -->

                    <div class="action-buttons">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-2"></i>

                            Save Changes

                        </button>


                        <a asp-controller="Admin"
                           asp-action="GradeComponents"
                           asp-route-subjectId="@Model.SubjectId"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-2"></i>

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}