
@model StudentGradeApp.Models.AppUser

@{
    ViewData["Title"] = "Delete Teacher";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Delete Teacher</h1>
            <p class="text-muted mb-0">
                Permanently remove a teacher account from the system.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="ManageTeachers"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Teachers
        </a>

    </div>


    <!-- Delete Confirmation Card -->
    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5 text-center">

                    <!-- Warning Icon -->
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle
                        d-inline-flex align-items-center justify-content-center mb-4"
                         style="width: 80px; height: 80px;">

                        <i class="bi bi-exclamation-triangle-fill fs-2"></i>

                    </div>


                    <!-- Heading -->
                    <h3 class="fw-bold mb-2">
                        Delete Teacher Account?
                    </h3>

                    <p class="text-muted mb-4">
                        Are you sure you want to permanently delete this teacher?
                        This action cannot be undone.
                    </p>


                    <!-- Teacher Information -->
                    <div class="bg-light rounded-4 p-4 mb-4">

                        <div class="d-flex align-items-center justify-content-center">

                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle
                                d-flex align-items-center justify-content-center me-3"
                                 style="width: 55px; height: 55px;">

                                <i class="bi bi-person-badge-fill fs-4"></i>

                            </div>

                            <div class="text-start">

                                <h5 class="fw-bold mb-1">
                                    @Model.FullName
                                </h5>

                                <p class="text-muted mb-0">
                                    @Model.Email
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Actions -->
                    <form asp-controller="Admin"
                          asp-action="DeleteTeacherConfirmed"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="d-flex justify-content-center gap-2">

                            <a asp-controller="Admin"
                               asp-action="ManageTeachers"
                               class="btn btn-light btn-lg px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger btn-lg px-4">
                                <i class="bi bi-trash-fill me-2"></i>
                                Yes, Delete Teacher
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
