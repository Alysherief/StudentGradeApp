@model IEnumerable<StudentGradeApp.Models.AppUser>

@{
    ViewData["Title"] = "Manage Teachers";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Teachers</h2>

        <a asp-controller="Admin"
           asp-action="CreateTeacher"
           class="btn btn-primary">
            Create Teacher
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No teachers have been created yet.
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var teacher in Model)
                            {
                                <tr>
                                    <td>
                                        @teacher.FullName
                                    </td>

                                    <td>
                                        @teacher.UserName
                                    </td>

                                    <td>
                                        @teacher.Email
                                    </td>

                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="EditTeacher"
                                           asp-route-id="@teacher.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="DeleteTeacher"
                                           asp-route-id="@teacher.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

    <div class="mt-3">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>