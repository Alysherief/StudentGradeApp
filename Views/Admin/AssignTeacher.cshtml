
@model StudentGradeApp.ViewModels.AssignTeacherViewModel

@{
    ViewData["Title"] = "Assign Teacher";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Assign Teacher</h1>
            <p class="text-muted mb-0">
                Assign a teacher to a subject they will be responsible for.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="ManageSubjects"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Subjects
        </a>

    </div>


    <!-- Assign Teacher Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- Card Heading -->
                    <div class="d-flex align-items-center mb-4">

                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                            <i class="bi bi-person-check-fill fs-4"></i>
                        </div>

                        <div>
                            <h4 class="fw-bold mb-1">Assignment Information</h4>
                            <p class="text-muted mb-0">
                                Select a subject and the teacher who will teach it.
                            </p>
                        </div>

                    </div>


                    <form asp-controller="Admin"
                          asp-action="AssignTeacher"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>


                        <!-- Subject -->
                        <div class="mb-4">

                            <label asp-for="SubjectId"
                                   class="form-label fw-semibold">
                                Subject
                            </label>

                            <select asp-for="SubjectId"
                                    class="form-select form-select-lg">

                                <option value="">
                                    -- Select Subject --
                                </option>

                                @foreach (var subject in ViewBag.Subjects)
                                {
                                    <option value="@subject.Id">
                                        @subject.Code - @subject.Name
                                        (@subject.CreditHours Credit Hours)
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="SubjectId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Teacher -->
                        <div class="mb-4">

                            <label asp-for="TeacherId"
                                   class="form-label fw-semibold">
                                Teacher
                            </label>

                            <select asp-for="TeacherId"
                                    class="form-select form-select-lg">

                                <option value="">
                                    -- Select Teacher --
                                </option>

                                @foreach (var teacher in ViewBag.Teachers)
                                {
                                    <option value="@teacher.Id">
                                        @teacher.FullName
                                        (@teacher.UserName)
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="TeacherId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">

                            <a asp-controller="Admin"
                               asp-action="ManageSubjects"
                               class="btn btn-light btn-lg px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success btn-lg px-4">
                                <i class="bi bi-person-check-fill me-2"></i>
                                Assign Teacher
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
