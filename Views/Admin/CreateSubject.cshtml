@model StudentGradeApp.ViewModels.CreateSubjectViewModel

@{
    ViewData["Title"] = "Create Subject";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Create Subject</h1>

            <p class="text-muted mb-0">
                Add a new subject to the university grading system.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="ManageSubjects"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back to Subjects

        </a>

    </div>


    <!-- Create Subject Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">


                    <!-- Card Heading -->
                    <div class="d-flex align-items-center mb-4">

                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">

                            <i class="bi bi-book-gear-fill fs-4"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-1">
                                Subject Information
                            </h4>

                            <p class="text-muted mb-0">
                                Enter the subject's details below.
                            </p>

                        </div>

                    </div>


                    <form asp-controller="Admin"
                          asp-action="CreateSubject"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>


                        <!-- Subject Name -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Enter subject name" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Code + Credit Hours -->
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label asp-for="Code"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Code"
                                       class="form-control form-control-lg"
                                       placeholder="e.g. CS101" />

                                <span asp-validation-for="Code"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6 mb-4">

                                <label asp-for="CreditHours"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="CreditHours"
                                       type="number"
                                       min="1"
                                       max="10"
                                       class="form-control form-control-lg"
                                       placeholder="Enter credit hours" />

                                <span asp-validation-for="CreditHours"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter subject description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">

                            <a asp-controller="Admin"
                               asp-action="ManageSubjects"
                               class="btn btn-light btn-lg px-4">

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-primary btn-lg px-4">

                                <i class="bi bi-book-plus-fill me-2"></i>

                                Create Subject

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}