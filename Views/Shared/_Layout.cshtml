<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - StudentGradeApp
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/StudentGradeApp.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        /* ================================
           NAVBAR
           ================================= */

        .main-navbar {
    position: relative;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e9ecef;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    padding: 10px 0;
}

        .navbar-brand {
            font-weight: 800;
            font-size: 1.35rem;
            color: #0d6efd !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d6efd, #4f8dfd);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.25);
        }

        .navbar-nav {
            align-items: center;
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            color: #495057 !important;
            padding: 9px 14px !important;
            border-radius: 9px;
            margin: 0 2px;
            transition: all 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            background-color: #f1f5ff;
            color: #0d6efd !important;
        }

        .navbar-nav .nav-link.active {
            color: #0d6efd !important;
            background-color: #eef4ff;
        }


        /* ================================
           PROFILE
           ================================= */

        .profile-dropdown {
    margin-left: 12px;
    position: relative;
    z-index: 1100;
}

        .profile-button {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid #e3e7ed;
            background: white;
            border-radius: 50px;
            padding: 5px 12px 5px 6px;
            transition: all 0.2s ease;
        }

        .profile-button:hover {
            background-color: #f8f9fc;
            border-color: #cfd6df;
            box-shadow: 0 5px 15px rgba(0,0,0,0.06);
        }

        .profile-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d6efd, #4f8dfd);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 600;
            color: #343a40;
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-arrow {
            font-size: 12px;
            color: #6c757d;
        }


        /* ================================
           DROPDOWN
           ================================= */

        .profile-menu {
    position: absolute;
    z-index: 1200;

    border: none;
    border-radius: 15px;
    padding: 8px;
    min-width: 220px;
    margin-top: 10px;

    background: #ffffff;

    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.18);
}

        .profile-menu .dropdown-header {
            padding: 12px 12px 8px;
        }

        .profile-menu .dropdown-header strong {
            color: #212529;
        }

        .profile-menu .dropdown-header small {
            color: #6c757d;
        }

        .profile-menu .dropdown-item {
            border-radius: 9px;
            padding: 10px 12px;
            font-size: 14px;
            transition: all 0.15s ease;
        }

        .profile-menu .dropdown-item:hover {
            background-color: #f1f5ff;
            color: #0d6efd;
        }

        .profile-menu .dropdown-item i {
            width: 22px;
            margin-right: 7px;
        }

        .profile-menu .dropdown-divider {
            margin: 7px 4px;
        }

        .logout-item {
            color: #dc3545 !important;
        }

        .logout-item:hover {
            background-color: #fff1f2 !important;
            color: #dc3545 !important;
        }


        /* ================================
           MAIN CONTENT
           ================================= */

        .main-content {
            min-height: calc(100vh - 150px);
        }


        /* ================================
           FOOTER
           ================================= */

        .main-footer {
            background: #ffffff;
            border-top: 1px solid #e9ecef;
            padding: 22px 0;
            margin-top: 40px;
        }

        .footer-brand {
            font-weight: 700;
            color: #0d6efd;
        }

        .footer-link {
            text-decoration: none;
            color: #6c757d;
            transition: color 0.2s ease;
        }

        .footer-link:hover {
            color: #0d6efd;
        }


        /* ================================
           MOBILE
           ================================= */

       @@media (max-width: 767px) {

    .navbar-nav {
        align-items: stretch;
        padding-top: 10px;
    }

    .profile-dropdown {
        margin-left: 0;
        margin-top: 8px;
    }

    .profile-button {
        width: 100%;
        justify-content: space-between;
        border-radius: 12px;
        padding: 7px 12px;
    }

    .profile-name {
        max-width: none;
        flex-grow: 1;
        text-align: left;
    }

}

    </style>

</head>


<body>

    <!-- ==========================================
         NAVBAR
         =========================================== -->

    <header>

        <nav class="navbar navbar-expand-md main-navbar">

            <div class="container">

                <!-- BRAND -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>

                    <span>
                        StudentGradeApp
                    </span>

                </a>


                <!-- MOBILE BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>

                                Home

                            </a>

                        </li>


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {

                            <!-- DASHBOARD -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2 me-1"></i>

                                    Dashboard

                                </a>

                            </li>

                        }

                    </ul>


                    <!-- ======================================
                         PROFILE / LOGIN
                         ======================================= -->

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {

                        <div class="dropdown profile-dropdown">

                            <button class="profile-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="profile-avatar">

                                    <i class="bi bi-person-fill"></i>

                                </span>

                                <span class="profile-name">

                                    @User.Identity.Name

                                </span>

                                <i class="bi bi-chevron-down profile-arrow"></i>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end profile-menu">

                                <!-- USER INFO -->

                                <li class="dropdown-header">

                                    <strong>
                                        @User.Identity.Name
                                    </strong>

                                    <br />

                                    <small>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <span>Administrator</span>
                                        }
                                        else if (User.IsInRole("Teacher"))
                                        {
                                            <span>Teacher</span>
                                        }
                                        else if (User.IsInRole("Student"))
                                        {
                                            <span>Student</span>
                                        }
                                    </small>

                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <!-- DASHBOARD -->

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Dashboard"
                                       asp-action="Index">

                                        <i class="bi bi-speedometer2"></i>

                                        Dashboard

                                    </a>

                                </li>


                                <!-- PROFILE -->

                                @if (User.IsInRole("Student"))
                                {

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">

                                            <i class="bi bi-person-circle"></i>

                                            My Profile

                                        </a>

                                    </li>

                                }
                                else if (User.IsInRole("Teacher"))
                                {

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">

                                            <i class="bi bi-person-circle"></i>

                                            My Profile

                                        </a>

                                    </li>

                                }
                                else if (User.IsInRole("Admin"))
                                {

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">

                                            <i class="bi bi-person-circle"></i>

                                            My Profile

                                        </a>

                                    </li>

                                }


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <!-- LOGOUT -->

                                <li>

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post"
                                          class="m-0">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item logout-item">

                                            <i class="bi bi-box-arrow-right"></i>

                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    }
                    else
                    {

                        <!-- LOGIN -->

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-primary px-4 rounded-pill">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Login

                        </a>

                    }

                </div>

            </div>

        </nav>

    </header>


    <!-- ==========================================
         MAIN CONTENT
         =========================================== -->

    <div class="container main-content">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- ==========================================
         FOOTER
         =========================================== -->

    <footer class="main-footer">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <span class="footer-brand">
                        <i class="bi bi-mortarboard-fill me-1"></i>
                        StudentGradeApp
                    </span>

                    <span class="text-muted ms-2">
                        © 2026
                    </span>

                </div>

                <div class="col-md-6 text-md-end mt-2 mt-md-0">

                    <a asp-controller="Home"
                       asp-action="Privacy"
                       class="footer-link">

                        Privacy Policy

                    </a>

                </div>

            </div>

        </div>

    </footer>


    <!-- ==========================================
         SCRIPTS
         =========================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>