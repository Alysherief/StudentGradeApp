@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10"
                             style="width: 90px; height: 90px;">
                            <i class="bi bi-shield-lock text-danger"
                               style="font-size: 42px;"></i>
                        </div>
                    </div>

                    <h1 class="fw-bold mb-3">
                        Access Denied
                    </h1>

                    <p class="text-muted fs-5 mb-4">
                        You don't have permission to access this page.
                    </p>

                    <p class="text-secondary mb-4">
                        Your account does not have the required permissions
                        for this section of the Student Grade Portal.
                        If you believe this is a mistake, please contact
                        your administrator.
                    </p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                        <!-- Back to Home -->
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary px-4 py-2 rounded-3">

                            <i class="bi bi-house-door me-2"></i>

                            Back to Home

                        </a>

                        <!-- Logout -->
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-secondary px-4 py-2 rounded-3">

                                <i class="bi bi-box-arrow-right me-2"></i>

                                Log Out

                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <div class="text-center mt-4">

                <small class="text-muted">
                    Student Grade Portal &bull; Secure Academic System
                </small>

            </div>

        </div>
    </div>
</div>