@model StudentGradeApp.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    .forgot-page {
        min-height: calc(100vh - 145px);
        display: flex;
        align-items: center;
        padding: 50px 0;
    }

    .forgot-wrapper {
        max-width: 1000px;
        margin: auto;
    }

    .forgot-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        background: white;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    }

    .forgot-brand-panel {
        background: linear-gradient(145deg, #0d6efd, #4f8dfd);
        color: white;
        padding: 55px 45px;
        min-height: 540px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .forgot-brand-panel::before {
        content: "";
        position: absolute;
        width: 350px;
        height: 350px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        top: -170px;
        right: -120px;
    }

    .forgot-brand-panel::after {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        bottom: -150px;
        left: -100px;
    }

    .forgot-brand-content {
        position: relative;
        z-index: 2;
    }

    .forgot-logo {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin-bottom: 28px;
    }

    .forgot-brand-panel h1 {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -0.7px;
        margin-bottom: 15px;
    }

    .forgot-brand-panel p {
        font-size: 1.05rem;
        line-height: 1.7;
        opacity: 0.88;
        max-width: 400px;
    }

    .forgot-feature {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
        font-size: 14px;
        opacity: 0.9;
    }

    .forgot-feature i {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.14);
    }

    .forgot-form-panel {
        padding: 55px 50px;
        background: white;
    }

    .forgot-form-header {
        margin-bottom: 32px;
    }

    .forgot-form-header h2 {
        font-size: 1.8rem;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .forgot-form-header p {
        color: #6b7280;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .forgot-field {
        margin-bottom: 24px;
    }

    .forgot-field .form-label {
        font-size: 14px;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        z-index: 2;
    }

    .forgot-input {
        padding-left: 43px !important;
        min-height: 50px;
        border-radius: 11px;
    }

    .forgot-input:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
    }

    .forgot-button {
        min-height: 50px;
        font-size: 15px;
        border-radius: 11px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(13, 110, 253, 0.18);
        transition: all .2s ease;
    }

    .forgot-button:hover {
        transform: translateY(-1px);
    }

    .back-login {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0d6efd;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all .2s ease;
    }

    .back-login:hover {
        color: #0a58ca;
        text-decoration: underline;
    }

    .security-note {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin-top: 24px;
        color: #9ca3af;
        font-size: 13px;
    }

    .success-message {
        border: none;
        border-radius: 11px;
        font-size: 14px;
        margin-bottom: 22px;
    }

    .validation-message {
        font-size: 13px;
        margin-top: 6px;
    }

    @@media (max-width: 767px) {

        .forgot-page {
            padding: 30px 15px;
        }

        .forgot-brand-panel {
            min-height: auto;
            padding: 40px 30px;
        }

        .forgot-brand-panel h1 {
            font-size: 2rem;
        }

        .forgot-form-panel {
            padding: 40px 30px;
        }

        .forgot-feature {
            margin-top: 20px;
        }
    }
</style>

<div class="forgot-page">

    <div class="container">

        <div class="forgot-wrapper">

            <div class="forgot-card">

                <div class="row g-0">

                    <div class="col-lg-6">

                        <div class="forgot-brand-panel">

                            <div class="forgot-brand-content">

                                <div class="forgot-logo">
                                    <i class="bi bi-key-fill"></i>
                                </div>

                                <h1>
                                    Reset Your Password
                                </h1>

                                <p>
                                    Don't worry. It happens to everyone.
                                    We'll help you get back into your
                                    Student Grade Portal account securely.
                                </p>

                                <div class="forgot-feature">

                                    <i class="bi bi-envelope-check-fill"></i>

                                    <span>
                                        Reset link sent directly to your email
                                    </span>

                                </div>

                                <div class="forgot-feature">

                                    <i class="bi bi-shield-check"></i>

                                    <span>
                                        Secure password recovery
                                    </span>

                                </div>

                                <div class="forgot-feature">

                                    <i class="bi bi-lock-fill"></i>

                                    <span>
                                        Your account remains protected
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="forgot-form-panel">

                            <div class="forgot-form-header">

                                <h2>
                                    Forgot password?
                                </h2>

                                <p>
                                    Enter the email address associated
                                    with your account and we'll send you
                                    a password reset link.
                                </p>

                            </div>

                            @if (TempData["PasswordResetMessage"] != null)
                            {
                                <div class="alert alert-success success-message">

                                    <i class="bi bi-check-circle me-2"></i>

                                    @TempData["PasswordResetMessage"]

                                </div>
                            }

                            <form asp-action="ForgotPassword"
                                  asp-controller="Account"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <div asp-validation-summary="ModelOnly"
                                     class="text-danger mb-3 validation-message">
                                </div>

                                <div class="forgot-field">

                                    <label asp-for="Email"
                                           class="form-label fw-semibold">

                                        Email Address

                                    </label>

                                    <div class="input-wrapper">

                                        <i class="bi bi-envelope"></i>

                                        <input asp-for="Email"
                                               class="form-control forgot-input"
                                               placeholder="Enter your email address"
                                               autocomplete="email" />

                                    </div>

                                    <span asp-validation-for="Email"
                                          class="text-danger validation-message">
                                    </span>

                                </div>

                                <button type="submit"
                                        class="btn btn-primary forgot-button w-100">

                                    <i class="bi bi-envelope-fill me-2"></i>

                                    Send Reset Link

                                </button>

                                <div class="security-note">

                                    <i class="bi bi-shield-lock"></i>

                                    Your account information is protected

                                </div>

                            </form>

                            <div class="text-center mt-4">

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="back-login">

                                    <i class="bi bi-arrow-left"></i>

                                    Back to Login

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}