```html
@{
    ViewData["Title"] = "Reset Password Expired";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10"
                             style="width: 90px; height: 90px;">
                            <i class="bi bi-clock-history text-warning"
                               style="font-size: 42px;"></i>
                        </div>
                    </div>

                    <h1 class="fw-bold mb-3">
                        Reset Link Expired
                    </h1>

                    <p class="text-muted fs-5 mb-4">
                        This password reset link is no longer valid.
                    </p>

                    <p class="text-secondary mb-4">
                        Password reset links are only valid for
                        <strong>10 minutes</strong> for your security.
                        Please request a new password reset link to continue.
                    </p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                        <a asp-controller="Account"
                           asp-action="ForgotPassword"
                           class="btn btn-primary px-4 py-2 rounded-3">

                            <i class="bi bi-envelope me-2"></i>
                            Request New Link

                        </a>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-secondary px-4 py-2 rounded-3">

                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Back to Login

                        </a>

                    </div>

                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">
                    Student Grade Portal &bull; Secure Academic System
                </small>
            </div>

        </div>
    </div>
</div>
```
