@model StudentGradeApp.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<style>
    .reset-page {
        min-height: calc(100vh - 145px);
        display: flex;
        align-items: center;
        padding: 50px 0;
    }

    .reset-wrapper {
        max-width: 1000px;
        margin: auto;
    }

    .reset-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        background: white;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    }

    /* =========================
       LEFT BRAND PANEL
       ========================= */

    .reset-brand-panel {
        background: linear-gradient(145deg, #0d6efd, #4f8dfd);
        color: white;
        padding: 55px 45px;
        min-height: 560px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .reset-brand-panel::before {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            top: -170px;
            right: -120px;
        }

        .reset-brand-panel::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            bottom: -150px;
            left: -100px;
        }

    .reset-brand-content {
        position: relative;
        z-index: 2;
    }

    .reset-logo {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin-bottom: 28px;
    }

    .reset-brand-panel h1 {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -0.7px;
        margin-bottom: 15px;
    }

    .reset-brand-panel p {
        font-size: 1.05rem;
        line-height: 1.7;
        opacity: 0.88;
        max-width: 400px;
    }

    .reset-feature {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
        font-size: 14px;
        opacity: 0.9;
    }

        .reset-feature i {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.14);
        }

    /* =========================
       RIGHT FORM PANEL
       ========================= */

    .reset-form-panel {
        padding: 55px 50px;
        background: white;
    }

    .reset-form-header {
        margin-bottom: 32px;
    }

        .reset-form-header h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .reset-form-header p {
            color: #6b7280;
            margin-bottom: 0;
        }

    .reset-field {
        margin-bottom: 22px;
    }

        .reset-field .form-label {
            font-size: 14px;
            margin-bottom: 8px;
        }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            z-index: 2;
            pointer-events: none;
        }

    .reset-input {
        padding-left: 43px !important;
        min-height: 48px;
    }

        .reset-input:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
        }

    .reset-button {
        min-height: 50px;
        font-size: 15px;
        border-radius: 11px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(13, 110, 253, 0.18);
        transition: all .2s ease;
    }

        .reset-button:hover {
            transform: translateY(-1px);
        }

    .password-note {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 22px;
        color: #9ca3af;
        font-size: 13px;
    }

    .back-login {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 25px;
        font-size: 14px;
    }

        .back-login a {
            text-decoration: none;
            font-weight: 600;
        }

    .validation-summary {
        border: none;
        border-radius: 11px;
        font-size: 14px;
        margin-bottom: 22px;
    }

    .field-validation {
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    /* =========================
       MOBILE
       ========================= */

    @@media (max-width: 767px) {

        .reset-page {
            padding: 30px 15px;
        }

        .reset-brand-panel {
            min-height: auto;
            padding: 40px 30px;
        }

            .reset-brand-panel h1 {
                font-size: 2rem;
            }

        .reset-form-panel {
            padding: 40px 30px;
        }

        .reset-feature {
            margin-top: 20px;
        }
    }
</style>


<div class="reset-page">

    <div class="container">

        <div class="reset-wrapper">

            <div class="reset-card">

                <div class="row g-0">

                    <!-- =========================
                         LEFT SIDE
                         ========================= -->

                    <div class="col-lg-6">

                        <div class="reset-brand-panel">

                            <div class="reset-brand-content">

                                <div class="reset-logo">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </div>

                                <h1>
                                    Student Grade Portal
                                </h1>

                                <p>
                                    Securely update your password and
                                    get back to managing your academic
                                    journey.
                                </p>


                                <div class="reset-feature">

                                    <i class="bi bi-shield-check"></i>

                                    <span>
                                        Secure password recovery
                                    </span>

                                </div>


                                <div class="reset-feature">

                                    <i class="bi bi-lock-fill"></i>

                                    <span>
                                        Protect your account
                                    </span>

                                </div>


                                <div class="reset-feature">

                                    <i class="bi bi-person-check-fill"></i>

                                    <span>
                                        Return to your account securely
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =========================
                         RIGHT SIDE
                         ========================= -->

                    <div class="col-lg-6">

                        <div class="reset-form-panel">

                            <div class="reset-form-header">

                                <h2>
                                    Reset your password
                                </h2>

                                <p>
                                    Enter a new password for your account.
                                </p>

                            </div>


                            <!-- VALIDATION SUMMARY -->

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger validation-summary">
                            </div>


                            <form asp-action="ResetPassword"
                                  asp-controller="Account"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <!-- HIDDEN USER ID -->

                                <input asp-for="UserId"
                                       type="hidden" />


                                <!-- HIDDEN TOKEN -->

                                <input asp-for="Token"
                                       type="hidden" />


                                <!-- NEW PASSWORD -->

                                <div class="reset-field">

                                    <label asp-for="NewPassword"
                                           class="form-label fw-semibold">

                                        New Password

                                    </label>

                                    <div class="input-wrapper">

                                        <i class="bi bi-lock"></i>

                                        <input asp-for="NewPassword"
                                               class="form-control reset-input"
                                               placeholder="Enter your new password"
                                               autocomplete="new-password" />

                                    </div>

                                    <span asp-validation-for="NewPassword"
                                          class="text-danger field-validation">
                                    </span>

                                </div>


                                <!-- CONFIRM PASSWORD -->

                                <div class="reset-field">

                                    <label asp-for="ConfirmPassword"
                                           class="form-label fw-semibold">

                                        Confirm New Password

                                    </label>

                                    <div class="input-wrapper">

                                        <i class="bi bi-shield-lock"></i>

                                        <input asp-for="ConfirmPassword"
                                               class="form-control reset-input"
                                               placeholder="Confirm your new password"
                                               autocomplete="new-password" />

                                    </div>

                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger field-validation">
                                    </span>

                                </div>


                                <!-- RESET BUTTON -->

                                <button type="submit"
                                        class="btn btn-primary reset-button w-100">

                                    <i class="bi bi-check-circle-fill me-2"></i>

                                    Reset Password

                                </button>


                                <!-- SECURITY NOTE -->

                                <div class="password-note">

                                    <i class="bi bi-shield-lock"></i>

                                    Your password is securely protected

                                </div>


                            </form>


                            <!-- BACK TO LOGIN -->

                            <div class="back-login">

                                <a asp-controller="Account"
                                   asp-action="Login">

                                    <i class="bi bi-arrow-left me-1"></i>

                                    Back to Login

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}